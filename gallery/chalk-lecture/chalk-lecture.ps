%!PS
% Poster: 36
% Chalk Lecture
%
% The simple pendulum, worked on a green board in thirty-three seconds
% of chalk. A pivot, a string and a bob are drawn, the angle and the
% weight on the bob; the weight is split, and the part along the arc
% gives Newton's law for the swing. For small angles sin theta is
% theta, the equation is a harmonic oscillator, and its period is
% T = 2 pi sqrt(L/g): about two seconds for a metre of string.
%
% Techniques
%   - Every stroke of the chalk is grown, not revealed: the stroke in
%     progress is drawn each frame with `/From 0 /To u`, which PSCat
%     0.8.0 made exact (behind the tip, what is drawn never changes).
%   - Persistent canvas, scheduled by pkink's `paintplan`. The board is
%     painted once, on frame 0; each stroke is kept on the board once,
%     whole, on the step that finishes it (`paintkept`), and until then
%     is regrown from 0 in `overlay` (`paintlive`), which is shown and
%     never kept. Chalk is not opaque, so regrowing it on the kept canvas
%     would lay the same stroke down again every frame. The plan counts
%     the scene's own steps, so it is exact at any `--fps`
%     (PSCatLabs/psanim#121, #122 were why this was once done by hand).
%   - Strokes as data, as in Chalk Proof: every path (lettering from
%     sgpath, formulas from mkpath, the diagram) is split in setup into
%     its subpaths, one per stroke, each with its own times. A hand's
%     pace: each stroke takes a moment plus its length over a speed, and
%     the chalk is lifted for a time that grows with the distance to the
%     next stroke.
%   - The stick of chalk is at `painttip` while a stroke is written, and
%     travels between strokes while it is lifted.
%   - `--param oneshot=1` paints the finished board on frame 0 from the
%     same plan (`paintall`): the reference the last frame is compared with.
<< /Size [1280 720] /Duration 38 /FPS 30 /Persist true
   /Background [0.20 0.13 0.08]
   /Title (Chalk Lecture)
   /Description (The simple pendulum worked on a green board: the diagram, the force along the arc, the small-angle step and the period, every stroke of the chalk grown as a hand would draw it.)
>> animation

(lib/artkit.ps) run (lib/paintkit.ps) run (lib/drykit.ps) run
(lib/handscript.ps) run (lib/strokeglyphs.ps) run (lib/drychalk.ps) run
(lib/mathkit.ps) run
/pkink use

/oneshot /oneshot 0 param cvi 1 eq def
/nostick /nostick 0 param cvi 1 eq def        % for tests: the chalk without the stick

% ------------------------------------------------------------ the board
/ghost {
  (\\nabla \\cdot E = \\rho / \\epsilon_0) 560 250 << /Size 40 /Seed 9 >> mkpath
  (last week) 150 110 << /Size 30 >> sgpath
} def
/board { 28 40 1224 652 << /Surface /greenboard /Tray 14 /Ghost /ghost load >> dcboard } def
board            % in setup: makes the board the chalk's surface (the paint is not kept)

% ------------------------------------------------------- strokes as data
% The current path -> an array of procedures, one per subpath.
/capture {
  mark [
  { /cp-y exch def /cp-x exch def ] cvx [ cp-x cp-y /moveto cvx }
  { /lineto cvx } { /curveto cvx } { /closepath cvx } pathforall
  ] cvx
  counttomark array astore exch pop
  dup length 1 sub 1 exch getinterval
} def

/strokes 1200 array def /nstrokes 0 def
/tcur 1.0 def                       % when the hand is next free
/lastxy null def                    % where the chalk last left the board
/pause { /tcur exch tcur add def } def

% A hand's pace. A stroke takes `settle` plus its length over the speed;
% between strokes the chalk is off the board for `lift` plus the
% distance over `travel`.
/settle 0.03 def /lift 0.035 def /travel 2400 def

% /colour opts speed item -    the current path becomes strokes, one per
% subpath, written one after another from when the hand is free.
/item {
  /it-speed exch def /it-opts exch def /it-col exch def
  capture newpath {
    /it-p exch def
    newpath it-p
    pathlength /it-len exch def
    0 pathpoint pop /it-y0 exch def /it-x0 exch def
    1 pathpoint pop /it-y1 exch def /it-x1 exch def newpath
    lastxy null ne {
      lastxy aload pop it-y0 sub dup mul exch it-x0 sub dup mul add sqrt
      travel div lift add pause
    } if
    /it-t1 tcur settle add it-len it-speed div add def
    strokes nstrokes <<
      /t0 tcur /t1 it-t1
      /col it-col /opts it-opts /path /it-p load
      /xy0 [it-x0 it-y0] /xy1 [it-x1 it-y1]
    >> put
    /nstrokes nstrokes 1 add def
    /tcur it-t1 def
    /lastxy [it-x1 it-y1] def
  } forall
} def

% ------------------------------------------------------------- the plan
/th 28 def                                  % the drawn angle, degrees
/sth th sin def /cth th cos def
/px 368 def /py 565 def /len 310 def /rb 17 def
/bx px len sth mul add def /by py len cth mul sub def
/mg 215 def                                 % the weight's arrow
/tx bx mg sth mul cth mul sub def /ty by mg sth mul sth mul sub def   % its part along the arc

/pen  << /Width 2.6 /Hand 0.6 >> def
/thin << /Width 1.8 /Hand 0.4 /Strength 0.45 >> def
/txt  << /Width 2.0 >> def
/wr 300 def                         % writing speed, units a second
/dr 620 def                         % drawing speed
/lab { << /Size 30 /Seed 7 /Irregular 0.5 >> mkpath } def
/arrowhead {  % x y angle ->   two short strokes back from a tip
  /ah-a exch def /ah-y exch def /ah-x exch def
  ah-x ah-a 155 add cos 15 mul add ah-y ah-a 155 add sin 15 mul add moveto ah-x ah-y lineto
  ah-x ah-a 205 add cos 15 mul add ah-y ah-a 205 add sin 15 mul add lineto
} def

% the heading
newpath (The simple pendulum) 90 622 << /Size 42 /Seed 2 >> sgpath /white txt wr item
newpath 86 606 moveto 470 610 lineto /white << /Width 2.4 /Hand 0.7 >> dr item
0.5 pause

% the support and the vertical through the pivot
newpath px 110 sub py moveto px 110 add py lineto /white pen dr item
newpath 0 1 8 { 25 mul px 100 sub add /hx exch def hx py 2 add moveto hx 16 add py 20 add lineto } for
/white thin 900 item
0.2 pause
newpath py 8 sub -16 py len sub 24 add { /dy exch def px dy moveto px dy 9 sub lineto } for
/white thin 900 item
0.3 pause
% the string, then the bob
newpath px py moveto px len rb sub sth mul add py len rb sub cth mul sub lineto /white pen dr item
newpath bx by rb 90 th add dup 360 add arc /white pen dr item
0.3 pause
% the angle and the length
newpath px py 78 270 270 th add arc /yellow pen dr item
newpath (\\theta) px 270 th 2 div add cos 104 mul add 9 sub py 270 th 2 div add sin 104 mul add 12 sub lab
/yellow txt wr item
newpath (L) px len 0.52 mul sth mul add cth 22 mul add 6 sub py len 0.52 mul cth mul sub sth 22 mul add 6 sub lab
/white txt wr item
0.5 pause
% the weight, and the part of it along the arc
newpath bx by moveto bx by mg sub lineto bx by mg sub 270 arrowhead /blue pen dr item
newpath (mg) bx 14 add by mg sub 4 add lab /blue txt wr item
0.4 pause
newpath 0 1 6 { 7 div /f exch def
  f [tx ty] [bx by mg sub] between aload pop moveto
  f 0.08 add [tx ty] [bx by mg sub] between aload pop lineto } for
/white thin 900 item
newpath bx rb cth mul sub by rb sth mul sub moveto tx ty lineto tx ty 180 th add arrowhead /pink pen dr item   % from the bob's edge
newpath (mg\\sin\\theta) tx 128 sub ty 44 sub lab /pink txt wr item
0.4 pause
% the arc the bob swings on
newpath -34 5 34 { 270 add /a exch def
  px a cos len mul add py a sin len mul add moveto px py len a a 2.6 add arc } for
/white thin 900 item
0.7 pause

% the algebra
/eqx 836 def
newpath (Newton, along the arc:) 650 600 << /Size 30 /Seed 5 >> sgpath /white txt wr item
0.4 pause
newpath [ (m L \\ddot\\theta &= -m g \\sin\\theta) ] eqx 528
  << /Size 36 /Seed 11 >> mkalign pop /white << /Width 2.3 >> wr item
0.7 pause
newpath (for small θ,) 650 452 << /Size 30 /Seed 13 >> sgpath /pink txt wr item
newpath (\\sin\\theta \\approx \\theta) 812 452 << /Size 32 /Seed 14 >> mkpath /pink txt wr item
0.7 pause
newpath [ (\\ddot\\theta &= -\\frac{g}{L}\\,\\theta)
          (\\theta(t) &= \\theta_0 \\cos \\omega t, \\quad \\omega = \\sqrt{g/L}) ] eqx 372
  << /Size 36 /Seed 17 /Leading 2.4 >> mkalign pop /white << /Width 2.3 >> wr item
0.8 pause
newpath (T = \\frac{2\\pi}{\\omega} = 2\\pi\\sqrt{\\frac{L}{g}}) 736 172 << /Size 46 /Seed 21 >> mkpath
/white << /Width 3.0 /Strength 0.7 >> wr item
0.4 pause
% the box, a side at a time
/bx0 702 def /by0 104 def /bx1 1100 def /by1 252 def
[ [bx0 by0 bx1 by0] [bx1 by0 bx1 by1] [bx1 by1 bx0 by1] [bx0 by1 bx0 by0] ] {
  aload pop newpath 4 2 roll moveto lineto /yellow << /Width 3 /Hand 0.8 >> dr item
} forall
0.6 pause
newpath (L = 1\\,\\mathrm{m}:\\quad T \\approx 2\\,\\mathrm{s}) 766 62 << /Size 32 /Seed 23 /Irregular 0.4 >> mkpath
/white << /Width 2.4 /Strength 0.7 >> wr item

/strokes strokes 0 nstrokes getinterval def
% The pace above is a hand's; the film keeps its proportions and fits
% the writing into `writing` seconds after `start`, leaving a hold.
/start 1.0 def /writing 33.0 def
/k writing tcur start sub div def
strokes { begin
  /t0 t0 start sub k mul start add def
  /t1 t1 start sub k mul start add def
end } forall
/writingends start writing add def

% ------------------------------------------------------------- per frame
% The hand slows a little into and out of a stroke.
/pace { dup /smooth ease 0.35 mul exch 0.65 mul add } def
% u colour opts chalk -     the stroke (its path is current) grown to u
/chalk {
  /ch-o exch def /ch-c exch def /ch-u exch def
  ch-c dcchalkcolor
  ch-u 1 ge { ch-o } { ch-o dup length 2 add dict copy dup /From 0 put dup /To ch-u put } ifelse
  dcchalk
} def
% The strokes as paintplan's: kept whole on the step that ends them,
% regrown from 0 in the overlay until then.
/plan [ strokes { begin
  << /At t0 /Until t1 /Path /path load /Ease /pace load
     /Paint [ col opts /chalk cvx ] cvx
     /col col /xy0 xy0 /xy1 xy1 >>
end } forall ] paintplan def

/scene {
  frame 0 eq { board oneshot { plan paintall } if } if
  oneshot not { plan paintkept } if
} def

% ---------------------------------------------------------- the stick
/sticktints << /white [0.95 0.95 0.92] /yellow [0.96 0.88 0.45] /blue [0.55 0.72 0.90] /pink [0.95 0.62 0.68] >> def
/stick {  % x y colour ->
  /st-c exch def
  nostick { pop pop } {
  gsave
    translate 52 rotate
    0 0 0 setrgbcolor 0.25 setalpha
    newpath 3 -5 moveto 64 -9 lineto 64 3 lineto 3 1 lineto closepath fill
    1 setalpha sticktints st-c get aload pop setrgbcolor
    newpath 0 -1 moveto 4 -5.5 lineto 62 -5.5 lineto 62 5.5 lineto 4 5.5 lineto 0 1 lineto closepath fill
    0 0 0 setrgbcolor 0.18 setalpha
    newpath 4 -5.5 moveto 62 -5.5 lineto 62 -1.5 lineto 4 -1.5 lineto closepath fill
  grestore
  } ifelse
} def

/overlay {
  oneshot not {
    plan paintlive
    % the stick on the stroke being written
    plan painttip { plan /Strokes get exch get /col get exch pop stick } if
    % lifted: the stick travels from where the last stroke ended
    /ss plan /Strokes get def
    1 1 ss length 1 sub { /si exch def
      ss si 1 sub get /Until get dup now lt ss si get /At get now ge and {
        ss si 1 sub get /xy1 get exch   % xy1 t1'
        now 1 index sub ss si get /At get 3 -1 roll sub div /smooth ease exch ss si get /xy0 get between
        aload pop ss si get /col get stick
      } { pop } ifelse
    } for
  } if
} def
