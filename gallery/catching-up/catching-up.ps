%!PS
% Poster: 19
% Catching Up
% A data story in four lines: life expectancy at birth in South Korea,
% Japan, the United States and China, 1960 to 2023. South Korea starts
% sixteen years behind the United States, is level with it in 2001 and
% ends five years ahead, within half a year of Japan. Each line is named
% at its end (serieslabels keeps the close names apart) and a tracer
% rides South Korea's line with its reading. Every number comes from
% life-expectancy.csv (UN World Population Prospects 2024, via Our World
% in Data) through data.py.

[ /open 3  /draw 9.5  /names 2.5  /level 6.5  /today 4.5  /close 3.5 ] storyboard

<< /Size [1280 720] /Duration storylength /FPS 30
   /Title (Catching Up)
   /Description (Life expectancy in South Korea, Japan, the United States and China, 1960 to 2023: South Korea goes from sixteen years behind the US to five ahead.)
>> animation

/pkchart use /pkdiagram use          % these load pkstage, pkmotion, pktype

% ---- data: printed by data.py (life expectancy at birth, years, 1960..2023) ----
/kor [
  53.76 54.44 55.03 54.99 55.34 55.78 55.42 60.87 60.87 61.43 62.18 62.67 63.22 63.77 64.24 64.67
  65.01 64.62 64.96 66.11 64.85 67.14 67.06 66.73 68.11 68.41 69.03 69.31 70.16 70.68 70.99 71.40
  72.18 72.75 72.89 73.38 74.02 74.53 75.03 75.62 76.24 76.92 77.23 77.50 77.96 78.45 79.03 79.43
  80.00 80.55 80.72 81.17 81.31 81.84 82.36 82.54 82.92 83.28 83.34 83.68 83.68 83.85 82.73 84.33
] def
/jpn [
  67.72 68.37 68.67 69.75 70.20 70.26 71.06 71.40 71.67 71.92 72.01 72.83 73.26 73.42 73.85 74.36
  74.76 75.33 75.66 76.17 76.14 76.56 77.07 77.11 77.51 77.80 78.21 78.63 78.55 78.98 78.99 79.26
  79.30 79.45 79.84 79.68 80.36 80.58 80.65 80.61 81.18 81.51 81.80 81.85 82.13 82.01 82.37 82.55
  82.63 82.97 82.92 82.67 83.17 83.40 83.64 83.88 84.06 84.19 84.29 84.42 84.67 84.55 84.05 84.71
] def
/usa [
  69.83 70.25 70.12 69.94 70.20 70.25 70.21 70.52 70.20 70.48 70.73 71.10 71.18 71.40 71.96 72.54
  72.84 73.23 73.41 73.83 73.73 74.12 74.46 74.55 74.67 74.65 74.73 74.86 74.83 75.11 75.37 75.52
  75.78 75.57 75.74 75.85 76.17 76.50 76.66 76.67 76.81 76.92 76.99 77.14 77.53 77.53 77.80 78.05
  78.13 78.48 78.67 78.70 78.82 78.82 78.88 78.72 78.69 78.65 78.80 78.92 77.01 76.38 77.98 79.30
] def
/chn [
  33.42 40.16 50.96 51.67 52.34 53.00 53.66 54.40 55.19 55.99 56.82 57.73 58.58 59.50 60.24 60.95
  61.23 62.46 63.10 63.70 64.24 64.78 65.25 65.73 66.15 66.53 66.89 67.26 67.61 67.93 68.15 68.61
  69.06 69.49 69.84 70.36 70.82 71.23 71.60 71.95 72.29 72.68 73.03 73.39 73.73 74.08 74.40 74.79
  74.83 75.32 75.67 75.89 76.20 76.45 76.71 76.98 77.21 77.24 77.71 77.94 78.02 78.12 78.20 77.95
] def
/series [ kor jpn usa chn ] def                 % line i is drawn in chartroles i
/names  [ (South Korea) (Japan) (United States) (China) ] def
/first-year 1960 def  /last-year 2023 def

% ---- places ----
/page canvasbox 6 vmin inset def
page 0.17 splity /body exch def /head exch def
% the data rectangle: room for tick labels left and below, for names right
/plot [ body 0 get 64 add  body 1 get 52 add  body 2 get 64 sub 236 sub  body 3 get 70 sub ] def

% ---- small words ----
% a b (headline) (subline) hl : a finding at the top of the page, from a to b
/hl { 4 dict begin /hl-s exch def /hl-h exch def /hl-b exch def /hl-a exch def
  hl-a hl-b [/mask-up 0.6] [/fade 0.4]
    { /title 42 face /fg ink head /nw boxpoint 42 sub moveto hl-h show } onstage
  hl-a 0.35 add hl-b [/fade 0.6] [/fade 0.4]
    { /body 24 face /muted ink head /nw boxpoint 84 sub moveto hl-s show } onstage
  end } def
% the line drawn up to data year x: the lines are clipped there
/upto { 1 dict begin /ut-x exch def
  gsave plotbox dup 2 ut-x 0 plotpoint pop 2 index 0 get sub 0 max put boxpath clip newpath
    0 1 series length 1 sub { /i exch def
      chartroles i get ink i 0 eq { 4.5 } { 2.5 } ifelse setlinewidth 1 setlinejoin 1 setlinecap
      series i get seriesline stroke
    } for
  grestore end } def

% ---- the film ----
/scene {
  ground
  /o /open beat def  /d /draw beat def  /n /names beat def
  /l /level beat def  /t /today beat def  /c /close beat def

  plot [first-year last-year] [30 90] plotframe
  << /Draw o 1 add o 2.6 add /cubic-out tween /YTicks 6 /XValues [ 1960 1970 1980 1990 2000 2010 2020 ]
     /Size 20 >> plotaxes

  % the years sweep across, every line drawn up to the same year
  /year d 0.3 add d 9.3 add /sine-inout tween first-year last-year between def
  year upto

  % each line named at its end as it arrives; Japan and South Korea end
  % 0.4 years apart, the US and China 1.3: serieslabels keeps them clear
  series names << /X year /Size 22 >> serieslabels

  % China's first point is the end of a famine
  d 1.0 add /fade { /body 18 face /muted ink
    1961 36 plotpoint moveto (the Great Leap Forward famine) show } enters

  % 1960: sixteen years behind
  l 0.2 add t /fade /fade {
    /fg ink 1.5 setlinewidth
    newpath 1960.5 kor 0 get plotpoint moveto 1960.5 usa 0 get plotpoint lineto
    0 0 0.8 /cubic-out tween trimpath stroke
    0 0.8 ramp setalpha              % the ends, ticked
    newpath 1960 kor 0 get plotpoint moveto 1961 kor 0 get plotpoint lineto
    1960 usa 0 get plotpoint moveto 1961 usa 0 get plotpoint lineto stroke 1 setalpha
    /body 20 face /fg ink 0.5 1 ramp setalpha
    1961.6 65.5 plotpoint moveto (16.1 years behind) show
    1 setalpha
  } onstage

  % a tracer on South Korea's line: it leads the pen, then goes back to
  % 2001, then on to today
  /tx [ d 0.3 add first-year  d 9.3 add last-year /sine-inout
        l 1.6 add last-year  l 3.6 add 2001 /cubic-inout
        t 0.2 add 2001  t 2.4 add last-year /cubic-inout ] keyframes def
  kor tx << /Draw d d 0.6 add ramp /XDecimals 0 /Decimals 1 /Suffix ( years) /Size 22 /Role /accent >> tracer

  % the headlines
  o 0.2 add l      (In 1960 a baby in South Korea could expect 54 years)
                   (life expectancy at birth, in years: the four lines are named where they end) hl
  l 0.4 add t      (Level with the United States in 2001)
                   (76.9 years in both, and South Korea ahead every year since) hl
  t 0.4 add c 60 add (Today: 84 years, thirty more than in 1960)
                   (5.0 years ahead of the United States in 2023, within half a year of Japan) hl

  % where the numbers come from
  o 2 add /fade { /body 18 face /muted ink
    page /se boxpoint moveto
    (UN World Population Prospects 2024, via Our World in Data) showright } enters
} def
