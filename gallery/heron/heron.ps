%!PS
% Poster: 45
% Heron: a haiku in ink and wash
% A haiku painted on one sheet of paper: hills in watercolour wash, reeds
% and a heron in brush ink, a vermilion sun that blooms and then, as a
% clean vector ring with a clock, moves on while the heron waits.
<< /Size [1280 720] /Duration 46 /FPS 30 /Persist true
   /Background [0.955 0.94 0.90]
   /Title (Heron)
   /Description (A haiku in ink and wash: hills, reeds and a heron paint themselves stroke by stroke on paper while kinetic type sets the words and a vector sun crosses the sky.)
>> animation

/pkink use /pktype use /pkmotion use
(lib/artkit.ps) run (lib/paintkit.ps) run

% ---- palette: paper, ink, two greys of wash, one accent -------------------
/c-paper [0.955 0.94 0.90] def
/c-ink   [0.13 0.13 0.16] def
/c-far   [0.50 0.58 0.64] def
/c-near  [0.26 0.33 0.40] def
/c-water [0.50 0.57 0.62] def
/c-verm  [0.84 0.24 0.14] def
<< /bg c-paper /fg c-ink /muted [0.45 0.44 0.42] /accent c-verm
   /title /AvantGarde-Book >> usetheme
/rgb { aload pop setrgbcolor } def

/framebox [40 40 1200 640] def

% ---- paths ---------------------------------------------------------------
/farhill { newpath 470 262 moveto 600 300 700 470 860 505 curveto
  960 525 1010 440 1110 455 curveto 1180 465 1230 500 1290 520 curveto
  1290 262 lineto closepath } def
/nearhill { newpath 820 246 moveto 900 262 960 372 1060 385 curveto
  1130 394 1160 330 1290 350 curveto 1290 246 lineto closepath } def
/reedpath { 6 dict begin /ht exch def /lean exch def /ry exch def /rx exch def
  newpath rx ry moveto
  rx ry ht 0.5 mul add  rx lean 0.3 mul add ry ht 0.8 mul add
  rx lean add ry ht add curveto end } def
/leafpath { 4 dict begin /ldx exch def /ly exch def /lx exch def
  newpath lx ly moveto lx ldx 0.3 mul add ly 30 add  lx ldx 0.8 mul add ly 50 add
  lx ldx add ly 30 add curveto end } def
/sunarc { newpath 700 575 moveto 820 668 1010 668 1150 548 curveto } def

/c-inkdry [0.22 0.22 0.25] def
/inkbrush { c-ink rgb penpath brushstroke } def     % [taper] inkbrush

% ---- the plan: [ start dur seed /kind clipdata {body} ] -------------------
% /sweep [xa xb]   revealed by a front moving from xa to xb
% /pen   [w {path}] revealed along a path (body uses penpath)
% /bloom [x y r]   revealed outward from a point
/plan [
  [ 1.6 3.2 11 /sweep [460 1250] { c-far rgb farhill
      << /Alpha 0.24 /Layers 2 /Wet 7 /Bloom 0.6 /Grain 0.5 /Seed 11 >> pkwash } ]
  % a second glaze under the far ridge
  [ 4.4 1.8 14 /sweep [850 1250] { c-far rgb newpath 860 505 moveto
      960 525 1010 440 1110 455 curveto 1180 465 1230 500 1290 520 curveto
      1290 370 lineto 1040 330 900 390 860 505 curveto closepath
      << /Alpha 0.22 /Layers 1 /Wet 9 /Bloom 0.3 /Grain 0.5 /Seed 14 >> pkwash } ]
  [ 6.0 2.6 12 /sweep [800 1250] { c-near rgb nearhill
      << /Alpha 0.34 /Layers 3 /Wet 5 /Bloom 0.5 /Grain 0.5 /Seed 12 >> pkwash } ]
  % mist: faint paper-coloured washes, one per pass, drifting right to left
  [ 8.6 2.6 13 /soak [14] { c-paper rgb newpath
      1160 pass 54 mul sub  264 [pass 7] hash01 18 mul add
      250 [pass 8] hash01 130 mul add  20 [pass 9] hash01 26 mul add ellipse
      << /Alpha 0.13 /Layers 1 /Wet 14 /Bloom 0 /Seed 130 pass add >> pkwash } ]
  % water: dry brush
  [ 11.0 1.3 21 /pen [40 { newpath 450 226 moveto 1245 232 lineto }]
      { c-water rgb penpath << /Width 8 /Bristles 18 /BristleWidth 1.1 /Load 0.5 /Dropout 0.45 >> pkdry } ]
  [ 11.9 1.1 22 /pen [40 { newpath 1180 196 moveto 560 190 lineto }]
      { c-water rgb penpath << /Width 6 /Bristles 14 /BristleWidth 1 /Load 0.4 /Dropout 0.55 >> pkdry } ]
  [ 12.7 1.0 23 /pen [40 { newpath 620 138 moveto 1150 142 lineto }]
      { c-water rgb penpath << /Width 5 /Bristles 12 /BristleWidth 1 /Load 0.35 /Dropout 0.6 >> pkdry } ]
  % reeds: liner brush, one after another; every other one grows a leaf
  0 1 12 { /i exch def
    /r-x 990 i 17 mul add [i 1] hash01 14 mul add def
    /r-y 112 [i 2] hash01 50 mul add def
    /r-lean [i 3] hash01 0.35 sub 110 mul def
    /r-ht 150 [i 4] hash01 130 mul add def
    /r-t 14 i 0.32 mul add def
    [ r-t 0.8 30 i add /pen [ 60 [ r-x r-y r-lean r-ht /reedpath cvx ] cvx ]
      { c-ink rgb penpath << /Width 4.5 /Taper 0.9 /Waver 0.6 /Depletion 0.2 >> pkliner } ]
    i 2 mod 0 eq {
      [ r-t 0.7 add 0.5 60 i add /pen
        [ 24 [ r-x r-lean 0.1 mul add  r-y r-ht 0.5 mul add
               [i 5] hash01 0.5 lt { -1 } { 1 } ifelse 34 [i 6] hash01 26 mul add mul /leafpath cvx ] cvx ]
        { [1 6 4 0] inkbrush } ]
    } if
  } for
  % heron: brush ink
  [ 19.4 1.3 41 /pen [80 { newpath 712 338 moveto 735 335 775 300 800 238 curveto }]
      { [6 40 48 30 10 0] inkbrush } ]
  [ 20.5 0.9 42 /pen [60 { newpath 745 312 moveto 780 290 800 250 814 214 curveto }]
      { c-inkdry rgb penpath << /Width 24 /Bristles 14 /Load 0.6 /Dropout 0.4 >> pkdry } ]
  [ 21.4 1.2 43 /pen [40 { newpath 716 336 moveto 680 352 724 400 694 436 curveto }]
      { [15 9 7 6 8] inkbrush } ]
  [ 22.6 0.8 44 /pen [40 { newpath 703 441 moveto 690 443 lineto 626 428 lineto }]
      { [9 13 6 3 0] inkbrush } ]
  [ 23.3 0.6 45 /pen [20 { newpath 698 446 moveto 725 448 745 438 762 420 curveto }]
      { [3.5 2 0] inkbrush } ]
  [ 24.0 0.8 46 /pen [20 { newpath 742 264 moveto 737 205 lineto 744 150 lineto }]
      { c-ink rgb penpath << /Width 3 /Taper 0.3 /Waver 0.3 /Depletion 0 >> pkliner } ]
  [ 24.7 0.8 47 /pen [20 { newpath 762 258 moveto 767 200 lineto 760 150 lineto }]
      { c-ink rgb penpath << /Width 3 /Taper 0.3 /Waver 0.3 /Depletion 0 >> pkliner } ]
  [ 25.6 0.9 48 /pen [30 { newpath 700 140 moveto 800 143 lineto }]
      { c-inkdry rgb penpath << /Width 7 /Bristles 10 /BristleWidth 1 /Load 0.4 /Dropout 0.6 >> pkdry } ]
  % the turn: the sun soaks in, pass over pass, from the centre out
  [ 29.0 3.4 51 /soak [34] { c-verm rgb newpath
      700 575  pass npass 0.6 mul div 0 1 clamp sqrt 42 mul 8 add  0 360 arc closepath
      << /Alpha 0.085 /Layers 1 /Wet 6 /Bloom 0.5 /Grain 0.3 /Seed 510 pass add >> pkwash } ]
] def

/snap { 2 div round 2 mul } def       % whole pixels at scale 1 and 0.5: no seams
/strokeu {                            % t -> u   (uses t0 dur kind)
  t0 sub dur div 0 1 clamp kind /soak ne { /sine-inout ease } if } def
/paintstroke { 24 dict begin
  aload pop /body exch def /cd exch def /kind exch def /seed exch def /dur exch def /t0 exch def
  /u1 now strokeu def  /u0 now dt sub strokeu def
  u1 u0 gt {
    gsave
    kind /sweep eq { cd aload pop /xb exch def /xa exch def
      /x0 u0 xa xb between snap def /x1 u1 xa xb between snap def
      x1 x0 gt { x0 0 x1 x0 sub 720 rectclip seed srand body } if } if
    kind /soak eq { /npass cd 0 get def
      /pass u1 npass mul 0.5 add floor def
      pass u0 npass mul 0.5 add floor gt { seed pass cvi add srand body } if } if
    kind /pen eq { seed srand
      /penpath cd 1 get def penpath u1 cd 0 get { body } revealalong } if
    grestore
  } if
  end } def

/scene {
  frame 0 eq { 0 0 1280 720 << /Tone c-paper /Grain 0.5 /Seed 3 >> pkpaper } if
  gsave framebox boxpath clip newpath
  plan { paintstroke } forall
  grestore
} def

/hhmm { 4 dict begin /m exch cvi def
  /two { dup 10 lt { (0) exch 2 string cvs strcat } { 2 string cvs } ifelse } def
  m 60 idiv two (:) strcat m 60 mod two strcat end } def

/overlay {
  1 setalpha
  % the frame
  /muted ink 1 setlinewidth
  framebox boxpath 0 0.3 2.4 /cubic-inout tween trimpath stroke
  % the brush, shown and not kept: a hairline at a wash front, a ring at a pen tip
  plan { 12 dict begin aload pop pop /cd exch def /kind exch def pop /dur exch def /t0 exch def
    now t0 ge now t0 dur add lt and {
      /u1 now strokeu def
      kind /sweep eq { /muted ink 0.6 setalpha 1 setlinewidth
        u1 cd 0 get cd 1 get between snap dup 40 moveto 680 lineto stroke 1 setalpha } if
      kind /pen eq { /accent ink 1.2 setlinewidth
        cd 1 get exec u1 pathpoint pop newpath 2 copy 9 0 360 arc stroke 1.5 0 360 arc fill } if
    } if end } forall
  % the words
  /title 30 face /fg ink
  3.0  { 100 566 moveto (morning mist lifting) /words 0.18 [/mask-up 0.7] kinetic } after
  15.0 { 100 520 moveto (a heron waits in the reeds) /words 0.18 [/mask-up 0.7] kinetic } after
  30.0 { 100 474 moveto (for the sun to move) /words 0.18 [/mask-up 0.7] kinetic } after
  % the accent tick, at the line being painted
  /ticky [ 0 564  14.4 564  15.2 518 /cubic-inout  29.4 518  30.2 472 /cubic-inout  42.4 472  43.6 80 /cubic-inout  46 80 ] keyframes def
  /accent ink
  2.6 [/fade 0.6] { 82 ticky 3 26 rectfill } enters
  % the sun as a diagram: a ring that leaves the painted sun and crosses the sky
  now 33.2 ge {
    /su 34.6 42 /cubic-inout tween def
    /accent ink 1.5 setlinewidth 1 setlinecap
    sunarc 0 su trimpath [1 8] 0 setdash stroke [] 0 setdash
    sunarc su pathpoint pop /sy exch def /sx exch def newpath
    /sr su 54 30 between def
    sx sy sr 90 450 arc 0 33.2 34.4 /cubic-inout tween trimpath stroke
    /title 15 face /muted ink
    34.4 [/fade 0.5] { sx sy sr add 9 add moveto su 372 1050 between hhmm showcenter } enters
  } if
  % the end title
  /title 17 face /fg ink
  43.4 [/fade 0.8] { 100 87 moveto (HERON) 8 { pop show } eachspaced } enters
} def
