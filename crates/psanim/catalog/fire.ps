%!PS
% Catalog entry: fire. A flame that loops: stylized (flat tongues, like a
% sticker) or realistic (a hot body, glow, embers, a little smoke).
% In a movie:  /camp /fire component   then   /camp << /Box [x y w h] >> place
% The flame stands at the bottom centre of its box; the room above and beside
% it is for lean, embers and smoke. Another look: /small /fire << /Seed 7
% /Params << /Height 0.3 /Width 0.08 /Intensity 0.5 >> >> instance
<< /Size [480 600] /Duration 4 /Loop true /Background /transparent
   /Title (Fire)
   /Description (A flame that loops: stylized, as flat tongues in two or three colours, or realistic, a hot body with glow, flicker, rising embers and faint smoke. Height, width, intensity and wind take it from a candle to a campfire to a torch.)
>> animation

/Style /realistic param dup type /stringtype eq { cvn } if /style exch def   % /realistic or /stylized
/Height 0.55 param /fhf exch def                % flame height, as a fraction of its box's height
/Width 0.42 param /fwf exch def                 % flame width, as a fraction of its box's width (up to 0.8; wide means several tongues)
/Intensity 1 param /inten exch def              % 0.3 a candle .. 1 a fire .. 1.6 a blaze: height, flicker, glow, embers
/Wind 0 param /wind exch def                    % -1 .. 1: leans the flame, carries the embers and smoke
/Embers 1 param /embf exch def                  % how many embers rise, 0 for none
/Smoke 0.25 param /smokef exch def              % realistic only: 0 none, 1 a heavy plume
/Glow style /realistic eq { 1 } { 0 } ifelse param /glowf exch def   % the halo of light: 0 is a cheap painted one, above 0 a glowing layer (a few ms a frame, more for a larger box); stylized has none
/Palette /fire param dup type /stringtype eq { cvn } if /pal exch def              % /fire /blue /green /violet

/palettes <<
  /fire   [ [1 0.97 0.80] [1 0.78 0.22] [1 0.42 0.06] [0.78 0.10 0.02] ]
  /blue   [ [0.92 0.97 1] [0.55 0.82 1] [0.20 0.45 1] [0.10 0.12 0.70] ]
  /green  [ [0.95 1 0.85] [0.55 1 0.45] [0.10 0.80 0.30] [0.02 0.40 0.20] ]
  /violet [ [1 0.95 1] [0.90 0.60 1] [0.60 0.25 0.95] [0.30 0.06 0.60] ]
>> def
/pal palettes pal known { palettes pal get } { palettes /fire get } ifelse def

% --- the box --------------------------------------------------------------------------
/cw width def  /ch height def
/fh fhf ch mul def                               % flame height, canvas units
/fw fwf 0.8 min cw mul def                       % flame width
/bx cw 2 div def  /by ch 0.10 mul def            % where the flame stands
/D duration def
/zs [99] hash01 400 mul def                   % where this instance's flicker is sampled: its seed
/stylz style /stylized eq def

% --- helpers --------------------------------------------------------------------------
% u  fcol  r g b      the ramp from hottest (0) to coolest (1), through the palette
/fcol {
  4 dict begin
    0 max 0.9999 min 3 mul dup cvi /i exch def i sub /f exch def
    0 1 2 { /k exch def pal i get k get 1 f sub mul pal i 1 add get k get f mul add } for
  end
} def
% key lag R  fnoise  v      -1..1, periodic in the loop; a larger lag is an earlier moment,
%                           so a bulge made low in the flame travels up it
/fnoise {
  3 dict begin
    /R exch def /lag exch def /key exch def
    progress lag sub 360 mul dup cos R mul exch sin R mul key 1.37 mul 0.5 add zs add gnoise3 2 mul
  end
} def
% u0 u1 x  fsmooth  s
/fsmooth { 3 dict begin /x exch def /u1 exch def /u0 exch def x u0 sub u1 u0 sub div 0 max 1 min dup dup mul exch 2 mul 3 exch sub mul end } def

% pts n  fspline     curves through the n points of pts (x y x y ...), the current point
%                    being the first: a Catmull-Rom spline, a corner at both ends
/fspline {
  8 dict begin
    /n exch def /pts exch def
    /px { n 1 sub min 0 max 2 mul pts exch get } def
    /py { n 1 sub min 0 max 2 mul 1 add pts exch get } def
    0 1 n 2 sub { /k exch def
      k 1 sub px  k px  k 1 add px  k 2 add px  /x3 exch def /x2 exch def /x1 exch def /x0 exch def
      k 1 sub py  k py  k 1 add py  k 2 add py  /y3 exch def /y2 exch def /y1 exch def /y0 exch def
      x1 x2 x0 sub 6 div add  y1 y2 y0 sub 6 div add
      x2 x3 x1 sub 6 div sub  y2 y3 y1 sub 6 div sub
      x2 y2 curveto
    } for
  end
} def

% x0 y0 hw h lean key  ftongue     the path of one tongue of flame standing at (x0 y0): half
%                                  width hw at its fullest, height h, its tip displaced by
%                                  lean. Its outline wavers, and the waver climbs it.
/vlev [0 0.18 0.42 0.66 0.86] def
/vprof [0.5 1 0.92 0.6 0.24] def
/ftongue {
  16 dict begin
    /key exch def /lean exch def /h exch def /hw exch def /y0 exch def /x0 exch def
    /h h 1 key 99 add 0 2.2 fnoise inten mul 0.1 mul add mul def
    /P 26 array def
    0 1 4 { /j exch def
      /v vlev j get def
      /cx x0 lean v 1.8 exp mul add
          key j add v 0.35 mul 2.2 fnoise hw mul v 0.8 exp mul wob mul add def
      /w hw vprof j get mul 1 key j add 50 add v 0.3 mul 2.2 fnoise 0.14 mul add mul def
      /y y0 h v mul add def
      P 5 j sub 2 mul cx w add put   P 5 j sub 2 mul 1 add y put
      P 7 j add 2 mul cx w sub put   P 7 j add 2 mul 1 add y put
    } for
    P 0 x0 lean add key 7 add 0.4 2.2 fnoise hw mul wob mul 0.5 mul add put
    P 1 y0 h add put
    P 24 P 0 get put   P 25 P 1 get put
    P 12 x0 put   P 13 y0 hw 0.4 mul sub put
    newpath P 0 get P 1 get moveto
    P 13 fspline
    closepath
  end
} def

% x y r lean  fdrop     a small drop, round below, pointed above, leaning
/fdrop {
  4 dict begin
    /ln exch def /r exch def /y exch def /x exch def
    newpath
    x y r 180 360 arc
    x r add y r 1.3 mul add  x r 0.5 mul add ln r mul 0.6 mul add y r 1.9 mul add  x ln r mul add y r 2.7 mul add curveto
    x r 0.5 mul sub ln r mul 0.6 mul add y r 1.9 mul add  x r sub y r 1.3 mul add  x r sub y curveto
    closepath
  end
} def

% --- the flame -----------------------------------------------------------------------------
/nc fwf 5 mul round cvi 1 max def               % tongues side by side: a candle has one, a campfire four
/cwid fw nc div def                              % the width one tongue has
/wob stylz { 0.8 } { 0.6 0.5 inten mul add } ifelse def     % how far the outline wavers

% the layers of a tongue, outermost first: width, height, temperature on the ramp, opacity
/nly stylz { 3 } { 4 } ifelse def
/lyw stylz { [1 0.64 0.34] } { [1 0.72 0.46 0.26] } ifelse def
/lyh stylz { [1 0.76 0.5] } { [1 0.84 0.64 0.42] } ifelse def
/lyt stylz { [0.62 0.34 0.07] } { [0.8 0.52 0.26 0.02] } ifelse def
/lya stylz { [1 1 1] } { [0.62 0.82 0.92 1] } ifelse def

% v  fcap  v'     a lean, kept inside the box
/fcap { dup abs cw fw sub 0.45 mul cw 0.3 mul min min exch 0 lt { neg } if } def
% c  ccx  x     the middle of tongue c       c  ccg  g     how tall it stands, 0..1
/ccx { 0.5 add nc div 0.5 sub fw mul bx add } def
/ccg {
  nc 1 gt {
    dup 0.5 add nc div 0.5 sub 2 mul abs 1.5 exp 0.4 mul 1 exch sub
    exch 40 add 0 1.2 fnoise 0.28 mul 0.72 add mul
  } { pop 1 } ifelse
} def

% the path, filled with a soft edge: two wider, fainter strokes under the fill
/ffill {
  stylz { fill } {
    gsave curA 0.14 mul setalpha ch 0.014 mul setlinewidth 1 setlinejoin stroke grestore
    gsave curA 0.3 mul setalpha ch 0.006 mul setlinewidth 1 setlinejoin stroke grestore
    fill
  } ifelse
} def

% a painted halo of warm light, for when /Glow is 0 and no layer is wanted
/halo {
  stylz not {
    0 1 7 { /q exch def
      pal 2 get aload pop setrgbcolor 0.02 inten mul setalpha
      gsave bx by fh 0.35 mul add translate fw 0.5 mul fh 0.45 mul div 1 scale
      0 0 fh 0.5 mul 1 q 9 div sub mul 0 360 arc fill grestore
    } for
  } if
} def

/flame {
  16 dict begin
    /sway 1 0 1.2 fnoise def
    /FH fh 0.85 inten 0.25 mul add mul ch 0.84 mul min def
    % licks: small tongues that rise out of the sides and die away, a few times a loop
    /cyc stylz { 2 } { 3 } ifelse def
    0 1 nc 1 sub { /c exch def
      0 1 1 { /j exch def
        /id c 2 mul j add def
        /v progress cyc mul [60 id] hash01 add def
        /k v floor cvi def /s v k sub def /kk k cyc mod def
        /env s 180 mul sin 1.3 exp def
        env 0.25 gt {
          /side j 0.5 sub 2 mul def
          /r1 [61 id kk] hash01 def
          lyt 0 get 0.12 add fcol setrgbcolor lya 0 get dup /curA exch def setalpha
          c ccx side cwid mul 0.38 mul add by
          cwid 0.2 mul 0.8 0.4 r1 mul add mul env 0.5 exp mul
          FH c ccg mul 0.5 0.25 r1 mul add mul env mul
          side cwid mul stylz { 0.06 } { 0.15 } ifelse mul wind FH mul 0.2 mul fcap add
          200 id add ftongue ffill
        } if
      } for
    } for
    0 1 nly 1 sub { /l exch def
      lyt l get fcol setrgbcolor lya l get dup /curA exch def setalpha
      0 1 nc 1 sub { /c exch def
        c ccx sway cwid mul 0.12 mul add  by fh 0.012 mul l mul add
        cwid 0.6 mul lyw l get mul
        FH c ccg mul lyh l get mul dup wind mul 0.55 mul fcap sway cwid mul 0.15 mul add
        c 10 mul l 3 mul add ftongue ffill
      } for
    } for
    % the blue at the foot of a candle's flame
    stylz not nc 1 eq and inten 0.85 lt and {
      0.25 0.45 1 setrgbcolor 0.85 inten sub 1.4 mul 0.75 min setalpha
      bx sway cwid mul 0.12 mul add by cwid 0.1 mul add translate
      1 1.1 scale 0 0 cwid 0.17 mul 0 360 arc fill
    } if
  end
} def

/embers {
  40 dict begin
    /ne 22 embf mul inten mul stylz { 0.4 mul } if round cvi def
    0 1 ne 1 sub { /i exch def
      /L 1.6 1.8 [20 i] hash01 mul add def
      /cyc D L div round cvi 1 max def
      /v progress cyc mul [21 i] hash01 add def
      /k v floor cvi def /u v k sub def /kk k cyc mod def
      /r1 [22 i kk] hash01 def /r2 [23 i kk] hash01 def /r3 [24 i kk] hash01 def
      /y0 by fh 0.3 mul add def
      /x bx r1 0.5 sub fw mul 0.6 mul add
         wind fh mul 0.9 mul u 1.3 exp mul add
         u 360 mul 1.5 mul r2 360 mul add sin fw mul 0.12 mul u mul add cw 0.03 mul cw 0.97 mul clamp def
      /y y0 fh 0.5 0.9 r2 mul add mul ch 0.98 mul y0 sub min u mul add def
      /a stylz { 1 0.55 1 u fsmooth sub } { 1 u sub 0.8 exp u 360 mul 3 mul r1 360 mul add sin 0.25 mul 0.75 add mul } ifelse
         0 0.06 u fsmooth mul def
      stylz {
        0.3 u 0.3 mul add fcol setrgbcolor a setalpha
        x y ch 600 div 2.6 r3 2 mul add mul wind 0.5 mul fdrop fill
      } {
        0.1 u 0.7 mul add fcol setrgbcolor a setalpha
        x y ch 600 div 1.6 r3 2 mul add mul 0 360 arc fill
      } ifelse
    } for
  end
} def

/smoke {
  20 dict begin
    0 1 5 { /i exch def
      /cyc 2 def
      /v progress cyc mul i 6 div add def
      /k v floor cvi def /u v k sub def /kk k cyc mod def
      /r1 [30 i kk] hash01 def
      /sr fw cw 0.5 mul min 0.2 0.45 u mul add mul def
      /x bx r1 0.5 sub fw mul 0.3 mul add wind fh mul 0.7 mul u mul add cw sr sub min sr max def
      /y0 by fh 0.5 mul add def
      /y y0 ch sr sub y0 sub 0 max u mul add def
      0.5 0.48 0.5 setrgbcolor
      /sa smokef 0.035 mul 0 0.15 u fsmooth mul 1 0.4 1 u fsmooth sub mul def
      0 1 5 { 6 div /q exch def sa setalpha x y sr 1 q 0.8 mul sub mul 0 360 arc fill } for
    } for
  end
} def

/realistic {
  smokef 0 gt { smoke } if
  glowf 0 gt {
    ch 0.05 mul glowf 0.5 inten 0.5 mul add mul 2 min { flame embers } glowing
  } { halo flame embers } ifelse
} def

/stylized { flame embers } def

/scene {
  style load exec
} def
