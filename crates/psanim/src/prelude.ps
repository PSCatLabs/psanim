%!PS
% psanim prelude: the PostScript half of the animation vocabulary.
%
% Loaded into every movie before the program runs. The native operators
% (crates/psanim/src/ops.rs) hold the clock and do the arithmetic; the
% procedures here are the parts that must run a body: a native operator
% cannot call a procedure, so `.during` decides whether the body is live and
% pushes its time scope, and `during` below runs it and pops the scope.
%
% Rules this file keeps, because user procedures run inside these:
%   - No `begin`: a body's `def` must land where the user expects.
%   - State lives on the operand stack, or in a closure built with `[ ... ] cvx`.
%   - Every procedure is `bind`-ed, so a user redefining `exec` or `now`
%     for themselves does not change what these do.

% --- declaration ---------------------------------------------------------
% dict animation -      declare the movie; first statement of a program.
/animation { .animation { quit } if } bind def

% --- time scopes -----------------------------------------------------------
% Time is part of the state a drawing procedure runs in, like the CTM. Each
% combinator runs `proc` with `now` and `progress` re-based, then puts the
% clock back.
/during     { .during     { exec .timepop } if } bind def  % a b proc     live for a <= now < b; inside, now runs 0..b-a
/after      { .after      { exec .timepop } if } bind def  % a proc       live for now >= a; inside, now starts at 0
/before     { .before     { exec .timepop } if } bind def  % b proc       live for now < b
/delayed    { .delayed    exec .timepop } bind def         % d proc       now is d seconds earlier inside
/timescaled { .timescaled exec .timepop } bind def         % k proc       now runs k times as fast inside
/looped     { .looped     exec .timepop } bind def         % p proc       now wraps every p seconds
/pingpong   { .pingpong   exec .timepop } bind def         % p proc       now runs 0..p..0..p
/attime     { .attime     exec .timepop } bind def         % t proc       now is frozen at t
/timewindow { .timewindow exec .timepop } bind def         % t dur proc   now is t, in a window dur long
/reversed   { .reversed   exec .timepop } bind def         % proc         now runs backward through the window
/globally   { .globally   exec .timepop } bind def         % proc         now is the movie time again, whatever scopes are open
% i gap proc staggered: item i of a row starts gap seconds after item i-1.
/staggered  { 3 1 roll mul exch delayed } bind def
% [ dur proc dur proc ... ] sequence: play the procs one after another.
/sequence   { .sequence   { exec .timepop } if } bind def

% --- layers ------------------------------------------------------------------
% The body of each runs with the caller's operands on top: the opacity,
% radius and so on are taken first and kept by the engine.
/faded   { exch   .fadebegin  exec .layerend } bind def      % alpha proc           draw proc as a group at one opacity
/blended { 3 1 roll .blendbegin exec .layerend } bind def    % alpha /mode proc     ... with a blend mode
/blurred { exch   .blurbegin  exec .layerend } bind def      % radius proc          draw proc out of focus
/glowing { 3 1 roll .glowbegin  exec .layerend } bind def    % radius strength proc draw proc with a halo
% procA procB u crossfade: A, with B over it at opacity u.
/crossfade {
  [ 4 1 roll 3 -1 roll /exec cvx 4 2 roll exch /faded cvx ] cvx exec
} bind def

% --- the canvas ----------------------------------------------------------------
% r g b backdrop: fill the canvas rectangle, 0 0 width height, in the current
% coordinates and inside the current clip. Call it before any camera. Because
% it respects both, a clip that starts with a backdrop can be wiped, pushed
% or irised by a transition.
/backdrop {
  gsave setrgbcolor 0 0 width height rectfill grestore
} bind def
% cx cy zoom angle camera: look at (cx, cy), magnified, rotated. Draw the
% world after it; wrap in gsave/grestore to come back to frame coordinates.
/camera {
  width 2 div height 2 div translate
  rotate dup scale
  neg exch neg exch translate
} bind def

% --- text ------------------------------------------------------------------------
% (str) u typed -> (prefix)     the first u (0..1) of the string, by characters
/typed {
  0 1 clamp 1 index length mul round cvi 0 exch getinterval
} bind def
% (str) showcenter              show centred on the current point
/showcenter {
  dup stringwidth pop 2 div neg 0 rmoveto show
} bind def
% (str) proc eachglyph          run proc once per character, with `(c) i` on
%                               the stack and the current point at that
%                               character's origin on the baseline.
/.glyphstep {            % i str proc x0 y0
  4 index 4 index exch 0 exch getinterval stringwidth pop   % i str proc x0 y0 wprefix
  3 -1 roll add exch moveto                                  % i str proc
  3 1 roll                                                   % proc i str
  1 index 1 getinterval exch                                 % proc (c) i
  3 -1 roll exec
} bind def
/eachglyph {             % str proc
  currentpoint                                 % str proc x0 y0
  3 index length 1 sub 0 exch 1 exch           % str proc x0 y0 0 1 n-1   (for's three operands, reordered below)
  7 3 roll                                     % 0 1 n-1 str proc x0 y0
  [ 5 1 roll /.glyphstep cvx ] cvx             % 0 1 n-1 { str proc x0 y0 .glyphstep }
  for
} bind def

% (str) track spacedwidth -> w   the width of the string set with `track`
%                               extra units after every character but the last
/spacedwidth {
  exch dup stringwidth pop exch length 1 sub 0 max 3 -1 roll mul add
} bind def
% (str) track proc eachspaced   like eachglyph, letterspaced: each character's
%                               origin is `track` units further along than
%                               its natural place.
/.spacedstep {           % i str track proc x0 y0
  5 index 5 index exch 0 exch getinterval stringwidth pop   % i str track proc x0 y0 wprefix
  6 index 5 index mul add                                     % ... wprefix + i*track
  3 -1 roll add exch moveto                                   % i str track proc
  exch pop                                                    % i str proc
  3 1 roll 1 index 1 getinterval exch                         % proc (c) i
  3 -1 roll exec
} bind def
/eachspaced {            % str track proc
  currentpoint                                 % str track proc x0 y0
  4 index length 1 sub 0 exch 1 exch           % str track proc x0 y0 0 1 n-1
  8 3 roll                                     % 0 1 n-1 str track proc x0 y0
  [ 6 1 roll /.spacedstep cvx ] cvx
  for
} bind def
% (str) u0 proc eachonpath      set the string along the current path, starting
%                               u0 (0..1) of the way along it. proc runs once
%                               per character with `(c) i` on the stack, in a
%                               coordinate system whose origin is the
%                               character's place on the path and whose x axis
%                               is the path's direction there; the current
%                               point is the character's origin. The current
%                               path is left as it was. `{ pop show }` sets the
%                               text.
/.onpathstep {           % i str u0 proc len
  4 index 4 index exch 0 exch getinterval stringwidth pop    % i str u0 proc len wprefix
  4 index 6 index 1 getinterval stringwidth pop 2 div        % ... wprefix halfw
  dup 3 1 roll add                                            % i str u0 proc len halfw centre
  2 index div 4 index add                                     % i str u0 proc len halfw u
  pathpoint                                                   % i str u0 proc len halfw x y ang
  gsave
    3 1 roll translate rotate newpath
    neg 0 moveto                                              % i str u0 proc len
    pop exch pop                                              % i str proc
    3 1 roll 1 index 1 getinterval exch                       % proc (c) i
    3 -1 roll exec
  grestore
} bind def
/eachonpath {            % str u0 proc
  pathlength                                   % str u0 proc len
  3 index length 1 sub 0 exch 1 exch           % str u0 proc len 0 1 n-1
  7 3 roll                                     % 0 1 n-1 str u0 proc len
  [ 5 1 roll /.onpathstep cvx ] cvx
  for
} bind def

% --- reels: clips joined by transitions ---------------------------------------------
% A transition is a procedure `procA procB u name`: draw the frame that is
% u (0..1) of the way from clip A to clip B. A and B are ready to run: each
% sets its own clock. Add one by putting it in `transitions` under any name;
% a reel entry [dur /thatname] then uses it.
% A B x y w h .wipe: A, then B clipped to the rectangle.
/.wipe {
  6 -1 roll exec
  gsave rectclip exec grestore
} bind def
/transitions 16 dict def
transitions begin
  /cut      { 0.5 lt { pop exec } { exch pop exec } ifelse } bind def
  /dissolve { crossfade } bind def
  % dip: A fades to black, then B rises from it.
  /dip {
    dup 0.5 lt
      { exch pop 2 mul 1 exch sub exch faded }                 % A at 1-2u
      { 3 -1 roll pop 2 mul 1 sub exch faded } ifelse          % B at 2u-1
  } bind def
  % wipes: B is revealed behind a moving edge.
  /wipe-right { /smooth ease width mul  0 exch 0 exch height .wipe } bind def
  /wipe-left  { /smooth ease width mul  dup width exch sub exch 0 exch height .wipe } bind def
  /wipe-up    { /smooth ease height mul 0 exch 0 exch width exch .wipe } bind def
  /wipe-down  { /smooth ease height mul dup height exch sub exch 0 3 1 roll width exch .wipe } bind def
  % iris: B opens as a growing circle from the centre.
  /iris {
    /cubic-inout ease
    3 -1 roll exec
    gsave
      width 2 div height 2 div
      3 -1 roll width dup mul height dup mul add sqrt 2 div mul   % radius: reaches the corners at u = 1
      0 360 arc clip newpath
      exec
    grestore
  } bind def
  % push: B slides in and shoves A out.
  /push-left {
    /cubic-inout ease width mul                                 % A B dx
    gsave dup neg 0 translate 3 -1 roll exec grestore           % B dx
    gsave width exch sub 0 translate exec grestore
  } bind def
  /push-right {
    /cubic-inout ease width mul
    gsave dup 0 translate 3 -1 roll exec grestore
    gsave width sub 0 translate exec grestore
  } bind def
  % zoom: A swells and fades while B settles into place.
  /zoom {
    /cubic-inout ease                                           % A B u
    dup 1 exch sub                                              % A B u 1-u
    4 -1 roll                                                   % B u 1-u A
    gsave
      width 2 div height 2 div translate
      2 index 0.6 mul 1 add dup scale
      width -2 div height -2 div translate
      faded                                                     % B u
    grestore
    gsave
      width 2 div height 2 div translate
      dup 0.25 mul 0.75 add dup scale
      width -2 div height -2 div translate
      exch faded
    grestore
  } bind def
end

/.clipproc { [ 4 1 roll /timewindow cvx ] cvx } bind def       % t dur proc -> { t dur proc timewindow }
% [ [dur proc] [dur /transition] [dur proc] ... ] reel
/reel {
  .reel
  dup 0 eq { pop } {
    1 eq { exec .timepop } {
      % kind u tB dB procB tA dA procA
      .clipproc                       % kind u tB dB procB A'
      4 1 roll .clipproc              % kind u A' B'
      3 -1 roll                       % kind A' B' u
      4 -1 roll                       % A' B' u kind
      transitions exch get exec
    } ifelse
  } ifelse
} bind def

% --- libraries ------------------------------------------------------------------
% /pkmotion use      load one of psanim's libraries, once. They are part of
%                    the program, not files: `psanim api --libs` lists them.
/.pk << /used 16 dict /cur 32 array /depth 0 /beats 1 dict /storylen 0 >> def
.pk /cur get 0 0 put
/use {
  dup type /stringtype eq { cvn } if
  dup .pk /used get exch known { pop } {
    dup .pk /used get exch true put
    .libsource cvx exec
  } ifelse
} bind def

% --- viewports: re-basing the canvas for a procedure -------------------------------
% box proc within     run proc inside the box [x y w h]: the origin is the
%                     box's corner, drawing is clipped to it, and `width`
%                     and `height` are the box's. A scene written against
%                     width and height can be placed in any box.
/within {
  exch aload pop gsave
  4 2 roll translate
  2 copy 0 0 4 2 roll rectclip
  .viewpush exec .viewpop
  grestore
} bind def
% box w h proc fitted   run proc, drawn for a canvas w by h, scaled to fit
%                       the box and centred in it.
/fitted {
  8 dict begin
    /ft-p exch def /ft-h exch def /ft-w exch def
    aload pop /ft-bh exch def /ft-bw exch def /ft-by exch def /ft-bx exch def
    /ft-s ft-bw ft-w div ft-bh ft-h div min def
    gsave
    ft-bx ft-bw ft-w ft-s mul sub 2 div add
    ft-by ft-bh ft-h ft-s mul sub 2 div add translate
    ft-s dup scale
    0 0 ft-w ft-h rectclip
    ft-w ft-h .viewpush
    /ft-p load
  end
  exec .viewpop grestore
} bind def

% --- storyboards: named stretches of the film ------------------------------------------
% [ /name seconds /name seconds ... ] storyboard     name the film's beats.
/storyboard {
  8 dict begin
    /sb-a exch def /sb-t 0 def
    sb-a length 2 idiv 1 add dict /sb-d exch def
    0 2 sb-a length 2 sub { /sb-i exch def
      sb-d sb-a sb-i get [ sb-t  sb-a sb-i 1 add get sb-t add ] put
      /sb-t sb-t sb-a sb-i 1 add get add def
    } for
    .pk /beats sb-d put  .pk /storylen sb-t put
  end
} bind def
/storylength { .pk /storylen get } bind def
/.beatget {
  .pk /beats get 1 index known not { .nobeat } if
  .pk /beats get exch get
} bind def
/beat     { .beatget 0 get } bind def                    % /name -> start time
/beatspan { .beatget aload pop } bind def                % /name -> start end
% /name proc inbeat      run proc during the beat, on its own clock,
%                        whatever time scopes are open.
/inbeat   { exch beatspan 3 -1 roll [ 4 1 roll /during cvx ] cvx globally } bind def
% /name proc frombeat    run proc from the beat's start to the end of the film.
/frombeat { exch beat exch [ 3 1 roll /after cvx ] cvx globally } bind def

% --- scripts: one thing after another -------------------------------------------------
% A script keeps a cursor: the time the next step starts. `then` runs its
% body from the cursor on (it stays), `thenfor` only until its time is up,
% and both move the cursor forward.
/cursor     { .pk /cur get .pk /depth get get } bind def
/.setcursor { .pk /cur get .pk /depth get 3 -1 roll put } bind def
/wait       { cursor add .setcursor } bind def                      % seconds wait
/then       { exch cursor exch wait exch after } bind def           % seconds proc then
/thenfor    { exch cursor exch 2 copy add exch wait 3 -1 roll during } bind def
/script {                                                           % proc script
  .pk /depth 2 copy get 1 add put  0 .setcursor
  exec
  .pk /depth 2 copy get 1 sub put
} bind def

% --- tempo: time in beats ---------------------------------------------------------------
% bpm tempo       set the tempo (in setup). n counts -> seconds; kick is 1 on
%                 every beat of the film's clock, falling to 0 before the next.
.pk /bpm 120 put
/tempo    { .pk exch /bpm exch put } bind def
/counts   { 60 mul .pk /bpm get div } bind def
/countnow { globaltime .pk /bpm get mul 60 div } bind def
/kick     { countnow dup floor sub 1 exch sub dup mul dup mul } bind def

% --- rows of things ------------------------------------------------------------------
% array gap proc cascade    run proc once per element, with `item i` on the
%                           stack, each gap seconds after the one before.
/.cascadestep {          % i arr gap proc
  3 index 3 -1 roll mul 4 1 roll      % delay i arr proc
  3 1 roll 1 index get exch           % delay proc item i
  3 -1 roll                           % delay item i proc
  mark 4 1 roll /exec cvx ] cvx delayed
} bind def
/cascade {               % arr gap proc
  2 index length 1 sub 0 exch 1 exch  % arr gap proc 0 1 n-1
  6 3 roll                            % 0 1 n-1 arr gap proc
  [ 4 1 roll /.cascadestep cvx ] cvx
  for
} bind def
% u proc onpath            run proc with the origin at the point u (0..1) of
%                          the way along the current path and the x axis
%                          along the direction of travel. The path is kept.
/onpath {
  exch pathpoint gsave 3 1 roll translate rotate newpath exec grestore
} bind def

% Pictures are composed over a transparent page; a program draws its own
% ground, or declares /Background.
