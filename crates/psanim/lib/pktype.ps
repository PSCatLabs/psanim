%!PS
% pktype: type that knows where it is, and type that moves.
%
% Set a font first (`/title 48 face`, or findfont/scalefont/setfont); these
% words measure with it.
/pkstage use /pkmotion use

% dict /Key default .opt -> value
/.opt { 3 1 roll 2 copy known { get exch pop } { pop pop } ifelse } bind def
% - fontsize -> size     the size of the current font
/fontsize { currentfont /FontMatrix get 0 get 1000 mul } bind def
% (str) showright -      show ending at the current point
/showright { dup stringwidth pop neg 0 rmoveto show } bind def
% Signs from the Symbol font, by name. A font chosen with `face` reads UTF-8,
% so a sign typed into a string works too; these keep working, and set the
% sign in Symbol's own design.
/symbols <<
  /neq (\271) /le (\243) /ge (\263) /approx (\273) /equiv (\272) /pm (\261)
  /times (\264) /div (\270) /dot (\327) /infinity (\245) /degree (\260)
  /arrow (\256) /larrow (\254) /uparrow (\255) /downarrow (\257) /implies (\336)
  /sum (\345) /product (\325) /sqrt (\326) /integral (\362) /partial (\266)
  /in (\316) /bullet (\267)
  /alpha (a) /beta (b) /gamma (g) /delta (d) /epsilon (e) /theta (q) /lambda (l)
  /mu (m) /pi (p) /rho (r) /sigma (s) /tau (t) /phi (f) /omega (w)
  /Delta (D) /Sigma (S) /Pi (P) /Omega (W)
>> def
% /name sym -          show a sign (/neq /arrow /pi /times ... see `symbols`)
%                      at the current point, at the current font's size; the
%                      current font is kept. `(a ) show /neq sym ( b) show`
/sym {
  symbols exch get
  currentfont exch fontsize /Symbol findfont exch scalefont setfont
  show setfont
} bind def
% /name symwidth -> w  the width `sym` will advance by
/symwidth {
  symbols exch get
  currentfont exch fontsize /Symbol findfont exch scalefont setfont
  stringwidth pop exch setfont
} bind def
% (str) textbox -> box   the box the string covers if shown at the current point
/textbox {
  stringwidth pop currentpoint         % w x y
  4 dict begin
    /tb-y exch def /tb-x exch def /tb-w exch def /tb-s fontsize def
    [ tb-x  tb-y tb-s 0.22 mul sub  tb-w  tb-s 0.98 mul ]
  end
} bind def
% (str) (part) partbox -> box    the box of the first occurrence of part
%                                within str, shown at the current point
/partbox {
  6 dict begin
    /pb-p exch def /pb-s exch def
    pb-s pb-p search {
      /pb-pre exch def pop pop
      currentpoint /pb-y exch def /pb-x exch def
      pb-x pb-pre stringwidth pop add pb-y moveto pb-p textbox
      pb-x pb-y moveto
    } { pop pb-s textbox } ifelse
  end
} bind def
% (str) box /anchor showin -     show the string inside the box, set against
%                                 that anchor (/c centres it both ways)
/showin {
  .anchorfrac
  8 dict begin
    /si-fy exch def /si-fx exch def
    aload pop /si-h exch def /si-w exch def /si-y exch def /si-x exch def
    /si-s exch def /si-cap fontsize 0.72 mul def
    si-x si-w si-s stringwidth pop sub si-fx mul add
    si-y si-h si-cap sub si-fy mul add
    moveto si-s show
  end
} bind def
% (str) box /anchor placetext -     move to where `showin` would start the
%   string, without showing it: for `kinetic`, `typewrite`, `charpath` or a
%   run in a box.  (TITLE) box /c placetext (TITLE) /glyphs 0.05 /rise kinetic
/placetext {
  .anchorfrac
  8 dict begin
    /si-fy exch def /si-fx exch def
    aload pop /si-h exch def /si-w exch def /si-y exch def /si-x exch def
    /si-s exch def /si-cap fontsize 0.72 mul def
    si-x si-w si-s stringwidth pop sub si-fx mul add
    si-y si-h si-cap sub si-fy mul add
    moveto
  end
} bind def
% (str) box /role fitface -      select the role's font (or any font name)
%                                 at the largest size at which the string
%                                 fits the box
/fitface {
  8 dict begin
    /ff-r exch def
    aload pop /ff-h exch def /ff-w exch def pop pop
    /ff-s exch def
    ff-r 100 face
    ff-r  ff-w ff-s stringwidth pop 0.001 max div 100 mul  ff-h 0.72 div  min
  end
  face
} bind def

% (text) width proc .wrap -> [ (line) ... ]    wraplines, measuring with proc
%                                               ((str) -> w)
/.wrap {
  8 dict begin
    /wl-m exch def /wl-w exch def
    [ exch splitlines {
      /wl-line () def
      splitwords {
        /wl-word exch def
        wl-line length 0 eq { /wl-line wl-word def } {
          /wl-try wl-line ( ) strcat wl-word strcat def
          wl-try wl-m wl-w gt
            { wl-line /wl-line wl-word def }
            { /wl-line wl-try def } ifelse
        } ifelse
      } forall
      wl-line
    } forall ]
  end
} bind def
% (text) width wraplines -> [ (line) ... ]    break into lines no wider
%                                             than width; \n forces a break
/wraplines { { stringwidth pop } .wrap } bind def
% (text) width emojilines -> [ (line) ... ]   the same, with `:name:` counted
%                                             as the emoji it will show
/emojilines { { emojitextwidth } .wrap } bind def
% --- emoji: small pictures drawn in PostScript -----------------------------------------
% Twelve round, flat, friendly pictures in one style: a warm yellow face, one dark
% brown line, a few flat colours. Each is drawn in a unit square centred on the
% origin (a circle of radius 0.5 just fits) and scaled to the size asked for.
% They paint in their own colours, with the current alpha, and leave the current
% colour and line width as they found them.
/.emoface {
  0.92 0.56 0.13 setrgbcolor 0 0 0.5 0 360 arc fill
  1 0.80 0.20 setrgbcolor 0 0.015 0.465 0 360 arc fill
  gsave 0.45 setalpha 1 0.93 0.62 setrgbcolor -0.07 0.16 0.26 0 360 arc fill grestore
} bind def
/.emoink { 0.34 0.19 0.08 setrgbcolor 0.05 setlinewidth 1 setlinecap 1 setlinejoin } bind def
/.emoeyes { .emoink -0.165 0.095 0.058 0 360 arc fill 0.165 0.095 0.058 0 360 arc fill } bind def
/.emosmile { .emoink 0 0.03 0.265 205 335 arc stroke } bind def
% x y .emotear -    a drop of water
/.emotear {
  gsave translate 0.40 0.76 1 setrgbcolor
  0 0.06 moveto -0.045 -0.02 -0.05 -0.075 0 -0.075 curveto 0.05 -0.075 0.045 -0.02 0 0.06 curveto fill
  grestore
} bind def
% the flame's outline, tip up
/.emoflame {
  0 -0.44 moveto
  -0.30 -0.44 -0.40 -0.20 -0.28 0.08 curveto
  -0.22 0.20 -0.08 0.28 0.04 0.47 curveto
  0.12 0.30 0.40 0.12 0.34 -0.14 curveto
  0.30 -0.34 0.18 -0.44 0 -0.44 curveto closepath
} bind def
/.emobar {                  % y w -    a finger, as a rounded bar
  0.105 -0.18 4 1 roll 4 array astore 0.052 roundpath
  gsave 1 0.80 0.20 setrgbcolor fill grestore
  0.93 0.56 0.13 setrgbcolor 0.02 setlinewidth stroke
} bind def
/.emoeye {                  % x -    one eye, looking right
  gsave 0 translate 0.7 1 scale
    1 setgray 0 0 0.22 0 360 arc fill
    0.34 0.19 0.08 setrgbcolor 0.03 setlinewidth 0 0 0.22 0 360 arc stroke
    0.09 -0.04 0.095 0 360 arc fill
  grestore
} bind def
/.emo 16 dict def
.emo begin
  /smile { .emoface .emoeyes .emosmile } bind def
  /laugh {
    .emoface .emoink 0.055 setlinewidth
    -0.17 0.085 0.075 25 155 arc stroke 0.17 0.085 0.075 25 155 arc stroke
    gsave newpath 0 -0.03 0.27 0 180 arcn closepath clip
      .emoink fill
      0 -0.03 0.27 0 180 arcn closepath fill
      0.86 0.26 0.28 setrgbcolor 0 -0.30 0.16 0 360 arc fill
      1 setgray -0.3 -0.03 0.6 0.07 rectfill
    grestore
    .emoink 0.04 setlinewidth newpath 0 -0.03 0.27 0 180 arcn closepath stroke
    -0.37 -0.04 .emotear 0.37 -0.04 .emotear
  } bind def
  /wink {
    .emoface .emoink -0.165 0.095 0.058 0 360 arc fill
    0.055 setlinewidth 0.165 0.115 0.075 200 340 arc stroke
    .emosmile
  } bind def
  /sad {
    .emoface .emoeyes .emoink 0.045 setlinewidth
    0 -0.22 0.2 40 140 arc stroke
    -0.27 0.2 moveto -0.1 0.255 lineto stroke 0.27 0.2 moveto 0.1 0.255 lineto stroke
    -0.2 -0.04 .emotear
  } bind def
  /cool {
    .emoface .emosmile
    .emoink 0.13 0.13 0.16 setrgbcolor
    [ -0.37 0.02 0.3 0.19 ] 0.06 roundpath fill [ 0.07 0.02 0.3 0.19 ] 0.06 roundpath fill
    -0.08 0.15 moveto 0.08 0.15 lineto 0.08 0.12 lineto -0.08 0.12 lineto fill
    gsave 0.5 setalpha 1 setgray 0.06 setlinewidth -0.31 0.16 moveto -0.2 0.2 lineto stroke
    0.13 0.16 moveto 0.24 0.2 lineto stroke grestore
  } bind def
  /heart {
    0.82 0.10 0.22 setrgbcolor
    0 -0.40 moveto -0.62 0.02 -0.34 0.5 0 0.17 curveto 0.34 0.5 0.62 0.02 0 -0.40 curveto fill
    gsave 0.5 setalpha 1 0.72 0.78 setrgbcolor -0.22 0.2 0.075 0 360 arc fill grestore
  } bind def
  /check {
    0.12 0.62 0.34 setrgbcolor 0 0 0.5 0 360 arc fill
    gsave 0.28 setalpha 1 setgray 0 0.06 0.4 0 360 arc fill grestore
    1 setgray 0.1 setlinewidth 1 setlinecap 1 setlinejoin
    -0.2 0.0 moveto -0.06 -0.15 lineto 0.22 0.17 lineto stroke
  } bind def
  /thumbsup {
    0.25 0.45 0.86 setrgbcolor [ -0.43 -0.3 0.17 0.5 ] 0.03 roundpath fill
    1 setlinecap
    0.93 0.56 0.13 setrgbcolor 0.2 setlinewidth newpath -0.06 0.12 moveto -0.02 0.33 lineto stroke
    1 0.80 0.20 setrgbcolor 0.155 setlinewidth newpath -0.06 0.12 moveto -0.02 0.33 lineto stroke
    -0.29 0.46 .emobar -0.19 0.52 .emobar -0.09 0.54 .emobar 0.01 0.52 .emobar
  } bind def
  /party {
    gsave -0.38 -0.38 translate
      gsave 45 rotate
        0.95 0.55 0.12 setrgbcolor 0 0 moveto 0.62 0.21 lineto 0.62 -0.21 lineto closepath fill
        0.86 0.30 0.30 setrgbcolor 0.2 0.07 moveto 0.2 -0.07 lineto 0.34 -0.12 lineto 0.34 0.12 lineto closepath fill
        0.86 0.30 0.30 setrgbcolor 0.48 0.16 moveto 0.48 -0.16 lineto 0.54 -0.18 lineto 0.54 0.18 lineto closepath fill
        gsave 0.62 0 translate 0.3 1 scale 0.98 0.78 0.25 setrgbcolor 0 0 0.21 0 360 arc fill grestore
      grestore
    grestore
    1 setlinecap 0.04 setlinewidth
    0.30 0.62 0.95 setrgbcolor 0.06 0.1 moveto 0.12 0.32 0.32 0.2 0.30 0.42 curveto stroke
    0.90 0.30 0.55 setrgbcolor 0.1 0.04 moveto 0.32 0.12 0.2 0.3 0.42 0.28 curveto stroke
    0.25 0.75 0.45 setrgbcolor 0.17 0.43 0.045 0 360 arc fill
    0.98 0.80 0.2 setrgbcolor 0.4 0.0 0.04 0 360 arc fill 0.04 0.4 0.04 0 360 arc fill
    0.30 0.62 0.95 setrgbcolor 0.42 0.4 0.04 0 360 arc fill
    0.90 0.30 0.55 setrgbcolor 0.28 0.18 0.035 0 360 arc fill
  } bind def
  /fire {
    0.96 0.30 0.10 setrgbcolor .emoflame fill
    gsave 0 -0.17 translate 0.62 dup scale 1 0.66 0.14 setrgbcolor .emoflame fill grestore
    gsave 0 -0.31 translate 0.32 dup scale 1 0.93 0.55 setrgbcolor .emoflame fill grestore
  } bind def
  /rocket {
    gsave -45 rotate
      0.98 0.58 0.12 setrgbcolor
      -0.07 -0.22 moveto -0.10 -0.34 -0.03 -0.40 0 -0.48 curveto 0.03 -0.40 0.10 -0.34 0.07 -0.22 curveto closepath fill
      0.85 0.20 0.25 setrgbcolor
      -0.12 0.02 moveto -0.30 -0.20 lineto -0.29 -0.28 lineto -0.12 -0.2 lineto closepath fill
      0.12 0.02 moveto 0.30 -0.20 lineto 0.29 -0.28 lineto 0.12 -0.2 lineto closepath fill
      0.94 0.95 0.98 setrgbcolor
      newpath 0 0.47 moveto 0.19 0.30 0.18 0.0 0.13 -0.24 curveto -0.13 -0.24 lineto -0.18 0.0 -0.19 0.30 0 0.47 curveto closepath fill
      gsave newpath 0 0.47 moveto 0.19 0.30 0.18 0.0 0.13 -0.24 curveto -0.13 -0.24 lineto -0.18 0.0 -0.19 0.30 0 0.47 curveto closepath clip
        0.85 0.20 0.25 setrgbcolor -0.3 0.25 0.6 0.3 rectfill
        gsave 0.4 setalpha 0.35 0.4 0.6 setrgbcolor 0.1 -0.3 0.2 0.8 rectfill grestore
      grestore
      0.25 0.45 0.80 setrgbcolor 0 0.08 0.075 0 360 arc fill
      1 setgray 0.025 setlinewidth 0 0.08 0.075 0 360 arc stroke
    grestore
  } bind def
  /eyes { -0.17 .emoeye 0.17 .emoeye } bind def
end
/emojinames [ /smile /laugh /wink /sad /cool /heart /thumbsup /party /fire /check /rocket /eyes ] def
% /name x y size emojiat -     draw the emoji centred on x y, size across
/emojiat {
  3 index .emo exch known not { pop pop pop /emojiat errordict /rangecheck get exec } if
  dup 0.05 lt { pop pop pop pop } {
    gsave newpath 3 1 roll translate dup scale .emo exch get exec grestore
  } ifelse
} bind def
% - emojiwidth -> w     how far `emoji` advances: a little more than the font's size
/emojiwidth { fontsize 1.2 mul } bind def
% /name emoji -     draw the emoji at the current point as a letter of the current
%                   font (sized to it, sitting on its baseline) and move past it
/emoji {
  4 dict begin
    currentpoint /em-y exch def /em-x exch def /em-s fontsize def
    em-x em-s 0.6 mul add em-y em-s 0.32 mul add em-s 1.1 mul emojiat
    em-x emojiwidth add em-y moveto
  end
} bind def
% (text) .emosplit -> [ (text) /name (text) ... ]   each `:name:` of a known emoji becomes a name
/.emosplit {
  6 dict begin
    /es-s exch def
    [
      {
        es-s (:) search not { dup length 0 gt { } { pop } ifelse exit } if
        /es-pre exch def pop /es-post exch def
        es-post (:) search {
          /es-nm exch def pop /es-rest exch def
          es-nm length 0 gt { .emo es-nm cvn known } { false } ifelse {
            es-pre length 0 gt { es-pre } if
            es-nm cvn
            /es-s es-rest def
          } {
            es-pre (:) strcat /es-s es-post def
          } ifelse
        } { pop es-pre (:) strcat /es-s es-post def } ifelse
      } loop
    ]
  end
} bind def
% (text) emojitextwidth -> w     the width `emojitext` will advance by
% (text) emojitextwidth -> w     the width `emojitext` will advance by
/emojitextwidth {
  0 exch .emosplit { dup type /nametype eq { pop emojiwidth } { stringwidth pop } ifelse add } forall
} bind def
% (text) emojitext -     show text at the current point, each `:name:` of a known
%                        emoji (:heart: :laugh: ... see `emojinames`) drawn as that emoji
/emojitext {
  .emosplit { dup type /nametype eq { emoji } { show } ifelse } forall
} bind def

% (text) box opts textlayout -> [ [ (line) x y ] ... ]
%   opts is an alignment (/left /center /right) or a dictionary:
%   << /Align /left /Leading 1.3 /VAlign /top >>   (/VAlign /top /middle /bottom)
/textlayout {
  12 dict begin
    dup type /nametype eq { /tl-al exch def /tl-o 0 dict def } { /tl-o exch def /tl-al tl-o /Align /left .opt def } ifelse
    aload pop /tl-h exch def /tl-w exch def /tl-y exch def /tl-x exch def
    /tl-lines exch tl-w wraplines def
    /tl-s fontsize def
    /tl-L tl-s tl-o /Leading 1.3 .opt mul def
    /tl-bh tl-lines length 1 sub tl-L mul tl-s 0.72 mul add def
    /tl-va tl-o /VAlign /top .opt def
    /tl-top
      tl-va /top eq { tl-y tl-h add } {
      tl-va /bottom eq { tl-y tl-bh add } { tl-y tl-h tl-bh add 2 div add } ifelse } ifelse def
    [ 0 1 tl-lines length 1 sub {
      /tl-i exch def /tl-str tl-lines tl-i get def
      [ tl-str
        tl-x tl-w tl-str stringwidth pop sub
          tl-al /center eq { 0.5 } { tl-al /right eq { 1 } { 0 } ifelse } ifelse mul add
        tl-top tl-s 0.72 mul sub tl-i tl-L mul sub ]
    } for ]
  end
} bind def
% (text) box opts paragraph -     set the text in the box, wrapped
/paragraph {
  textlayout { aload pop moveto show } forall
} bind def

% (str) proc eachword -     like eachglyph, by words: proc runs per word
%                           with `(word) i` on the stack and the current
%                           point at the word's origin
/.wordstep {             % i words xs x0 y0 proc
  6 dict begin
    /ws-p exch def /ws-y exch def /ws-x exch def /ws-xs exch def /ws-w exch def /ws-i exch def
    ws-xs ws-i get ws-x add ws-y moveto
    ws-w ws-i get ws-i /ws-p load
  end exec
} bind def
/eachword {
  8 dict begin
    /ew-p exch def /ew-w exch splitwords def
    /ew-x 0 def /ew-sp ( ) stringwidth pop def
    /ew-xs [ ew-w { ew-x exch stringwidth pop ew-x add ew-sp add /ew-x exch def } forall ] def
    currentpoint /ew-y0 exch def /ew-x0 exch def
    0 1 ew-w length 1 sub
    [ ew-w ew-xs ew-x0 ew-y0 /ew-p load /.wordstep cvx ] cvx
  end
  for
} bind def

% (str) /unit gap spec kinetic -     show the string at the current point,
%     each unit (/glyphs, /words or /whole) entering with the motion, gap
%     seconds after the one before. Wrap it in `leaving` for the exit.
/.kn-unit {              % (unit) i     (inside kinetic's dictionary)
  kn-i0 add /kn-i exch def /kn-c exch def
  kn-c ( ) ne {
    kn-i kn-g { kn-s { kn-c show } entering } staggered
  } if
} bind def
/kinetic {
  8 dict begin
    /kn-s exch def /kn-g exch def /kn-u exch def /kn-str exch def
    /kn-i0 where { pop } { /kn-i0 0 def } ifelse
    kn-u /glyphs eq { kn-str { .kn-unit } eachglyph } {
    kn-u /words eq { kn-str { .kn-unit } eachword } {
      kn-str 0 .kn-unit
    } ifelse } ifelse
  end
} bind def
% - .kn-count: how many units the string had, so a paragraph's stagger runs on
/.kn-units {             % str unit -> n
  dup /glyphs eq { pop charcount } { /words eq { splitwords length } { pop 1 } ifelse } ifelse
} bind def
% (text) box opts /unit gap spec kineticparagraph -    a wrapped paragraph
%     whose glyphs, words or lines (/lines) enter one after another
/kineticparagraph {
  12 dict begin
    /kp-s exch def /kp-g exch def /kp-u exch def
    /kp-lay 4 1 roll textlayout def
    /kn-i0 0 def
    kp-lay {
      aload pop moveto /kp-str exch def
      kp-u /lines eq {
        kp-str /whole kp-g kp-s kinetic /kn-i0 kn-i0 1 add def
      } {
        kp-str kp-u kp-g kp-s kinetic
        /kn-i0 kn-i0 kp-str kp-u .kn-units add def
      } ifelse
    } forall
  end
} bind def

% box u marker -       a highlighter bar over the first u of the box, in the
%                      current colour: draw it before the text it marks
/marker {
  exch aload pop
  6 dict begin
    /mk-h exch def /mk-w exch def /mk-y exch def /mk-x exch def /mk-u exch 0 1 clamp def
    mk-u 0 gt {
      gsave newpath [ mk-x mk-h 0.12 mul sub  mk-y  mk-w mk-h 0.24 mul add mk-u mul  mk-h ] mk-h 0.12 mul roundpath fill grestore
    } if
  end
} bind def
% box u underline -    a rule under the box, drawn on as u goes 0 to 1, in
%                      the current colour and line width
/underline {
  exch aload pop
  6 dict begin
    /mk-h exch def /mk-w exch def /mk-y exch def /mk-x exch def /mk-u exch 0 1 clamp def
    mk-u 0 gt {
      gsave newpath mk-x mk-y mk-h 0.02 mul sub moveto mk-w mk-u mul 0 rlineto stroke grestore
    } if
  end
} bind def
% box u strikethrough -     a straight line through the middle of the box,
%                           drawn on as u goes 0 to 1, in the current
%                           colour and line width. Keeps the current point.
/strikethrough {
  exch aload pop
  6 dict begin
    /mk-h exch def /mk-w exch def /mk-y exch def /mk-x exch def /mk-u exch 0 1 clamp def
    mk-u 0 gt {
      gsave newpath mk-x mk-y mk-h 0.47 mul add moveto mk-w mk-u mul 0 rlineto stroke grestore
    } if
  end
} bind def
% (str) u typewrite -  the first u of the string with a block caret after
%                      it, blinking once the typing is done
/typewrite {
  6 dict begin
    /tw-u exch def /tw-s exch def
    tw-s tw-u typed show
    tw-u 1 lt now 0.9 fmod 0.45 lt or {
      currentpoint fontsize 0.55 mul fontsize 0.72 mul 4 2 roll
      exch fontsize 0.06 mul add exch 4 2 roll rectfill
    } if
  end
} bind def

% [ [t0 t1 (text)] ... ] box opts captions -     show the caption whose time
%     has come, centred at the bottom of the box, on a plate. opts:
%     << /Size 30 /Role /body /Plate true /Karaoke false >>. With /Karaoke
%     the words light up across the caption's time.
/captions {
  16 dict begin
    /cp-o exch def /cp-box exch def
    /cp-size cp-o /Size 4.2 vmin .opt def
    {
      aload pop /cp-text exch def /cp-t1 exch def /cp-t0 exch def
      now cp-t0 ge now cp-t1 lt and {
        cp-o /Role /body .opt cp-size face
        /cp-w cp-text stringwidth pop def
        /cp-b cp-box cp-w cp-size 1.2 mul add cp-size 1.9 mul /s placed def
        now cp-t0 sub 0.15 div 1 min  cp-t1 now sub 0.15 div 1 min  mul
        {
          cp-o /Plate true .opt {
            gsave /bg ink 0.72 setalpha cp-b cp-size 0.35 mul roundpath fill grestore
          } if
          cp-b /c boxpoint exch cp-w 2 div sub exch cp-size 0.36 mul sub moveto
          cp-o /Karaoke false .opt {
            /cp-p now cp-t0 sub cp-t1 cp-t0 sub 0.85 mul div def
            /cp-n cp-text charcount def /cp-seen 0 def
            cp-text {
              pop /cp-wd exch def
              /cp-a cp-seen cp-n div def
              /cp-seen cp-seen cp-wd charcount add 1 add def
              cp-p cp-seen cp-n div ge { /fg } { cp-p cp-a ge { /accent } { /muted } ifelse } ifelse ink
              cp-wd show
            } eachword
          } { /fg ink cp-text show } ifelse
        } faded
      } if
    } forall
  end
} bind def

% --- runs: a line of mixed type, for mathematics ---------------------------------------
% A run list is an array whose elements are each one of
%   (text)            in the current font
%   /name             a sign or Greek letter from `symbols` (/pi /times /neq ...)
%   [/it (r)]         italic, as variables are set
%   [/sup x] [/sub x] raised or lowered and smaller; x is (text) or /name
%   [/frac a b]       a over b; each is (text) or /name
% e.g.  [ (Area = ) /pi [/it (r)] [/sup (2)] ]
/.runbase {              % x -> draws (text) or /name at the current point
  dup type /nametype eq { sym } { show } ifelse
} bind def
/.runbasew { dup type /nametype eq { symwidth } { stringwidth pop } ifelse } bind def
/.runw {                 % run -> width
  dup type /arraytype ne { .runbasew } {
    4 dict begin
      /rn-r exch def /rn-k rn-r 0 get def
      rn-k /it eq { currentfont /Times-Italic fontsize face rn-r 1 get stringwidth pop exch setfont } {
      rn-k /frac eq {
        rn-r 1 get .runbasew rn-r 2 get .runbasew max 0.62 mul fontsize 0.24 mul add
      } {
        rn-r 1 get .runbasew 0.62 mul
      } ifelse } ifelse
    end
  } ifelse
} bind def
/.rundraw {              % run -     at the current point; advances it
  dup type /arraytype ne { .runbase } {
    8 dict begin
      /rn-r exch def /rn-k rn-r 0 get def /rn-f currentfont def /rn-s fontsize def
      currentpoint /rn-y exch def /rn-x exch def
      rn-k /it eq { /Times-Italic rn-s face rn-r 1 get show rn-f setfont } {
      rn-k /frac eq {
        /rn-w rn-r .runw def
        rn-f 0.62 scalefont setfont
        rn-x rn-w rn-r 1 get .runbasew sub 2 div add rn-y rn-s 0.42 mul add moveto rn-r 1 get .runbase
        rn-x rn-w rn-r 2 get .runbasew sub 2 div add rn-y rn-s 0.18 mul sub moveto rn-r 2 get .runbase
        rn-f setfont
        gsave rn-s 0.05 mul setlinewidth newpath rn-x rn-s 0.06 mul add rn-y rn-s 0.30 mul add moveto
          rn-w rn-s 0.12 mul sub 0 rlineto stroke grestore
        rn-x rn-w add rn-y moveto
      } {
        rn-f 0.62 scalefont setfont
        0 rn-k /sup eq { rn-s 0.40 mul } { rn-s -0.16 mul } ifelse rmoveto
        rn-r 1 get .runbase
        rn-f setfont currentpoint pop rn-y moveto
      } ifelse } ifelse
    end
  } ifelse
} bind def
% runs runwidth -> w
/runwidth { 0 exch { .runw add } forall } bind def
% runs showruns -          show the whole line at the current point
/showruns { { .rundraw } forall } bind def
% runs i showrun -         show only run i, at the place it has in the line
%                          that starts at the current point: bring an
%                          equation in term by term, each with its own motion
/showrun {
  4 dict begin
    /sr-i exch def /sr-r exch def
    currentpoint /sr-y exch def /sr-x exch def
    sr-x 0 1 sr-i 1 sub { sr-r exch get .runw add } for sr-y moveto
    sr-r sr-i get .rundraw
  end
} bind def
% runs i runbox -> box     the box of run i in the line that starts at the
%                          current point, for a marker, a ring or a note
/runbox {
  4 dict begin
    /sr-i exch def /sr-r exch def
    currentpoint /sr-y exch def /sr-x exch def
    [ sr-x 0 1 sr-i 1 sub { sr-r exch get .runw add } for
      sr-y fontsize 0.22 mul sub
      sr-r sr-i get .runw
      fontsize 0.98 mul ]
  end
} bind def

% --- credits: text rolling upward -----------------------------------------------------
% sections opts credits -     the roll, on the current scope's clock.
% A section list is an array of entries, each an array that starts with a name:
%   [/heading (Cast)]                    a heading, centred, in the heading face and accent;
%                                        [/heading (THE END) 2.5] sets it 2.5 times as large
%   [/pair (Director) (Name) (Name) ..]  a role on the left of the gutter, right-aligned,
%                                        and its names on the right, left-aligned
%   [/name (Name) (Name) ..]             centred names, one to a line
%   [/text (a line)]                     a centred note, smaller and muted
%   [/space n]                           n lines of space
%   [/proc { ... } h]                    a slot h high; the procedure runs with the origin
%                                        at its centre, over the column's centre (a logo)
% Nothing here owns a clock beyond `now`; `creditsat` takes the distance instead.
% The layout is measured in a dictionary (the settings), never open while a
% caller's procedure runs: drawing works on a list of finished records.
/.cr-heading {
  cl-cy 0 gt { /cl-cy cl-cy HeadGap add def } if
  /cl-hs cl-n 2 gt { HS cl-e 2 get mul } { HS } ifelse def
  /cl-bl cl-cy cl-hs Lead mul 2 div cl-hs 0.36 mul add add def
  [ /t cl-bl 0 cl-e 1 get HeadFace cl-hs HeadInk /c ]
  /cl-tr cl-hs 0.25 mul def  /cl-cy cl-cy cl-hs Lead mul cl-tr add add def
} bind def
/.cr-pair {
  2 1 cl-n 1 sub {
    /cl-j exch def
    /cl-bl cl-cy S Lead mul 2 div S 0.36 mul add add def
    cl-j 2 eq { [ /t cl-bl Gutter 2 div neg cl-e 1 get RoleFace RS RoleInk /r ] } if
    [ /t cl-bl Gutter 2 div cl-e cl-j get NameFace S NameInk /l ]
    /cl-cy cl-cy S Lead mul add def
  } for
  /cl-tr PairGap def  /cl-cy cl-cy cl-tr add def
} bind def
/.cr-names {
  1 1 cl-n 1 sub {
    /cl-j exch def
    /cl-bl cl-cy S Lead mul 2 div S 0.36 mul add add def
    [ /t cl-bl 0 cl-e cl-j get NameFace S NameInk /c ]
    /cl-cy cl-cy S Lead mul add def
  } for
  /cl-tr PairGap def  /cl-cy cl-cy cl-tr add def
} bind def
/.cr-text {
  1 1 cl-n 1 sub {
    /cl-j exch def
    /cl-bl cl-cy TS Lead mul 2 div TS 0.36 mul add add def
    [ /t cl-bl 0 cl-e cl-j get TextFace TS TextInk /c ]
    /cl-cy cl-cy TS Lead mul add def
  } for
  /cl-tr PairGap def  /cl-cy cl-cy cl-tr add def
} bind def
/.cr-proc {
  [ /p cl-cy cl-e 2 get 2 div add 0 cl-e 1 get 0 cl-e 2 get 0 0 ]
  /cl-cy cl-cy cl-e 2 get add def
} bind def
% sections .cr-lay -> [ items ] height       (the settings dictionary is open)
% An item is [ kind depth x payload role size ink align ]: depth is how far
% below the top of the content its baseline (or, for a procedure, its
% centre) lies; x is from the column's centre.
/.cr-lay {
  /cl-cy 0 def /cl-tr 0 def
  [ exch {
    /cl-e exch def /cl-k cl-e 0 get def /cl-n cl-e length def
    /cl-tr 0 def
    cl-k /heading eq { .cr-heading } {
    cl-k /pair eq { .cr-pair } {
    cl-k /name eq { .cr-names } {
    cl-k /text eq { .cr-text } {
    cl-k /proc eq { .cr-proc } {
    cl-k /space eq { /cl-cy cl-cy cl-e 1 get S mul Lead mul add def } {
      /credits errordict /rangecheck get exec
    } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse
  } forall ]
  cl-cy cl-tr sub
} bind def

% opts .cr-set -> settings
/.cr-set {
  80 dict begin
    /cs-o exch def
    /Box cs-o /Box known { cs-o /Box get } { canvasbox } ifelse def
    /S cs-o /Size Box 2 get Box 3 get min 0.04 mul .opt def
    /HS cs-o /HeadingSize S 1.3 mul .opt def
    /RS cs-o /RoleSize S 0.82 mul .opt def
    /TS cs-o /TextSize S 0.82 mul .opt def
    /Lead cs-o /Leading 1.5 .opt def
    /Gutter cs-o /Gutter S 1.2 mul .opt def
    /HeadGap cs-o /HeadingGap S 2.6 mul .opt def
    /PairGap S 0.45 mul def
    /HeadFace cs-o /HeadingFace /title .opt def
    /RoleFace cs-o /RoleFace /body .opt def
    /NameFace cs-o /NameFace /body .opt def
    /TextFace cs-o /TextFace /body .opt def
    /HeadInk cs-o /HeadingInk /accent .opt def
    /RoleInk cs-o /RoleInk /muted .opt def
    /NameInk cs-o /NameInk /fg .opt def
    /TextInk cs-o /TextInk /muted .opt def
    /Fade cs-o /Fade 0.12 .opt def
    /Snap cs-o /Snap true .opt def
    /Settle cs-o /Settle 0 .opt def
    /Cards cs-o /Cards [ ] .opt def
    /CardTime cs-o /CardTime 4 .opt def
    /CardFade cs-o /CardFade 0.7 .opt def
    /Final cs-o /Final [ ] .opt def
    /FinalGap cs-o /FinalGap Box 3 get 0.5 mul .opt def
    currentdict
  end
} bind def
% sections opts .cr-prep -> settings, with the layout and the timing worked out:
% /Items /H (content height) /Dist (how far it travels) /Speed /CardsT /Total
/.cr-prep {
  .cr-set begin
    /Sections exch def
    Sections .cr-lay /H exch def /Items exch def
    Final length 0 gt {
      Final .cr-lay /fH exch def /fItems exch def
      /fOff H FinalGap add def
      fItems { dup 1 get fOff add 1 exch put } forall
      /Items [ Items aload pop fItems aload pop ] def
      /Dist fOff fH 2 div add Box 3 get 2 div add def
      /H fOff fH add def
    } {
      /Dist H Box 3 get add def
    } ifelse
    /Speed cs-o /Speed known { cs-o /Speed get } {
      cs-o /Duration known { Dist Settle add cs-o /Duration get div } { Box 3 get 0.08 mul } ifelse
    } ifelse def
    /CardsT Cards length CardTime mul def
    /Total CardsT Dist Settle add Speed div add def
    currentdict
  end
} bind def

% t .cr-off -> distance rolled after t seconds of rolling (settings open)
/.cr-off {
  0 max /co-t exch def
  /co-t1 Dist Settle sub Speed div def
  co-t co-t1 le { Speed co-t mul } {
    /co-T2 Settle 0.0001 max 2 mul Speed div def
    co-t co-t1 sub dup co-T2 ge { pop Dist } {
      /co-tau exch def
      Dist Settle sub Speed co-tau mul add Speed co-tau co-tau mul mul co-T2 2 mul div sub
    } ifelse
  } ifelse
} bind def
% t .cr-vel -> units a second the roll moves at after t seconds of rolling (settings open);
% a roll with no /Settle stops dead, and counts as moving at its speed to the end
/.cr-vel {
  0 max /cv-t exch def
  /cv-t1 Dist Settle sub Speed div def
  cv-t cv-t1 le Settle 0 le or { Speed } {
    /cv-T2 Settle 0.0001 max 2 mul Speed div def
    cv-t cv-t1 sub dup cv-T2 ge { pop 0 } { cv-T2 div 1 exch sub Speed mul } ifelse
  } ifelse
} bind def
% y .cr-snap -> y    the same place, moved to where a whole device pixel starts,
%                    so a roll moves a whole number of pixels a frame
/.cr-snap {
  0 1 dtransform abs 1e-4 gt exch abs 1e-4 lt and
  { 0 exch transform exch pop round 0 exch itransform exch pop } if
} bind def
% items ytop g fadefrac .cr-place -> [ record ... ]    (settings open)
% A record is [ kind x y alpha payload size role ink align ], absolute and
% ready to draw; items outside the box are left out.
/.cr-place {
  /cp-f exch def /cp-g exch def /cp-ytop exch def
  /cp-cx Box 0 get Box 2 get 2 div add def
  /cp-by Box 1 get def /cp-bh Box 3 get def
  /cp-fd cp-f cp-bh mul def
  [ exch {
    /cp-i exch def
    /cp-y cp-ytop cp-i 1 get sub def
    /cp-m cp-i 5 get cp-i 0 get /p eq { 2 div } if def
    cp-y cp-by cp-m sub ge  cp-y cp-by cp-bh add cp-m add le  and {
      cp-fd 0 gt {
        cp-y cp-by sub cp-fd div 0 1 clamp  cp-by cp-bh add cp-y sub cp-fd div 0 1 clamp  mul
        dup dup mul exch 2 mul 3 exch sub mul             % ease it
      } { 1 } ifelse
      cp-g mul /cp-a exch def
      cp-a 0.002 gt {
        [ cp-i 0 get  cp-cx cp-i 2 get add  cp-y  cp-a  cp-i 3 get  cp-i 5 get  cp-i 4 get  cp-i 6 get  cp-i 7 get ]
      } if
    } if
  } forall ]
} bind def
% records .cr-draw -     (no dictionary is open while a caller's procedure runs)
/.cr-draw {
  {
    dup 0 get /p eq {
      gsave dup 3 get setalpha dup 1 get 1 index 2 get translate 4 get exec grestore
    } {
      10 dict begin
        aload pop /dr-al exch def /dr-ink exch def /dr-role exch def /dr-size exch def
        /dr-s exch def /dr-a exch def /dr-y exch def /dr-x exch def pop
        gsave dr-a setalpha dr-ink ink dr-role dr-size face
        dr-al /c eq { dr-x dr-s stringwidth pop 2 div sub } {
          dr-al /r eq { dr-x dr-s stringwidth pop sub } { dr-x } ifelse } ifelse
        dr-y moveto dr-s show grestore
      end
    } ifelse
  } forall
} bind def
% (settings open) -> records for now
/.cr-frame {
  /cf-t now def
  cf-t CardsT lt {
    /cf-k cf-t CardTime div cvi Cards length 1 sub min def
    /cf-u cf-t cf-k CardTime mul sub def
    Cards cf-k get .cr-lay /cf-h exch def
    Box 1 get Box 3 get 2 div add cf-h 2 div add
    cf-u CardFade div CardTime cf-u sub CardFade div min 0 1 clamp
    0 .cr-place
  } {
    % Snapping to whole pixels keeps type from shimmering while the roll moves
    % a pixel or more a frame; below that it would make the roll hold and hop,
    % so the settle tail glides.
    /cf-fast cf-t CardsT sub .cr-vel dt mul 0 1 dtransform exch pop abs mul 1 ge dt 0 le or def
    Items Box 1 get cf-t CardsT sub .cr-off add Snap cf-fast and { .cr-snap } if
    1 Fade .cr-place
  } ifelse
} bind def

% sections opts credits -     roll the credits: on the current scope's clock, first
%     the /Cards (each held /CardTime seconds), then the sections rise from the
%     bottom of the /Box at a constant rate, and stop where /Final is centred.
%     opts (all optional): /Box [x y w h] the window it rolls through; /Size
%     /HeadingSize /RoleSize /TextSize /Leading /Gutter /HeadingGap; /HeadingFace
%     /RoleFace /NameFace /TextFace (theme roles or font names); /HeadingInk
%     /RoleInk /NameInk /TextInk; /Speed units a second, or /Duration seconds the
%     roll takes (the speed follows); /Fade the fraction of the box's height
%     over which lines fade at its top and bottom edges; /Snap (true: move
%     whole device pixels); /Cards [ sections ... ]; /Final sections and
%     /FinalGap; /Settle units over which the roll slows to its stop.
/credits {
  .cr-prep begin .cr-frame end .cr-draw
} bind def
% sections opts offset creditsat -      the roll after it has moved `offset` units: for
%     a caller who owns the clock (cards and /Settle are not applied)
/creditsat {
  3 1 roll .cr-prep begin
    /ca-off exch def
    Items Box 1 get ca-off add Snap { .cr-snap } if 1 Fade .cr-place
  end .cr-draw
} bind def
% sections opts creditsheight -> h     the height of the whole roll, final card included
/creditsheight { .cr-prep /H get } bind def
% sections opts creditsspeed -> units a second       (from /Speed, /Duration or the default)
/creditsspeed { .cr-prep /Speed get } bind def
% sections opts creditsduration -> seconds       cards, then the roll to its stop:
%     the length to give the movie, or the scope of the roll
/creditsduration { .cr-prep /Total get } bind def
