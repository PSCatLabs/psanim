%!PS
% pkchart: data that moves.
%
% A chart is drawn from numbers every frame, so animating one is
% animating its numbers: `u valuesA valuesB between` is the chart half-way
% between two datasets, and every word here takes a /Grow that brings its
% marks in.
%
%   box [x0 x1] [y0 y1] plotframe      where the plot is and what it spans
%   << ... >> plotaxes                   axes, ticks, grid
%   [v ...] << /Grow u >> bars         columns        ... hbars: rows, rankable
%   [[x y] ...] plotline               a path through data: stroke it, trim it
%   [v ...] box << /Grow u >> donut
/pkstage use /pkmotion use /pktype use /pkdiagram use

/.plot << /x 0 /y 0 /w 100 /h 100 /x0 0 /x1 1 /y0 0 /y1 1 >> def
/chartroles [ /accent /accent2 /accent3 /good /bad /muted ] def
/.chartrole { chartroles exch chartroles length mod get } bind def

% box [x0 x1] [y0 y1] plotframe -
/plotframe {
  aload pop /.plot .mine /y1 3 -1 roll put /.plot .mine /y0 3 -1 roll put
  aload pop /.plot .mine /x1 3 -1 roll put /.plot .mine /x0 3 -1 roll put
  aload pop /.plot .mine /h 3 -1 roll put /.plot .mine /w 3 -1 roll put /.plot .mine /y 3 -1 roll put /.plot .mine /x 3 -1 roll put
} bind def
/plotbox { .plot begin [ x y w h ] end } bind def
% x y plotpoint -> X Y     data to canvas
/plotpoint {
  .plot begin
    y0 sub y1 y0 sub div h mul y add exch
    x0 sub x1 x0 sub div w mul x add exch
  end
} bind def
% The box given to plotframe is the data rectangle: tick labels and axis
% titles are drawn outside it (about 3 x /Size to the left and below), so
% inset the box from the page.
% << /XTicks 5 /YTicks 5 /Grid true /Draw u /Decimals 0 /XDecimals 0 /Suffix ()
%    /Fade true   while the range moves, ticks cross-fade between round steps instead of jumping
%    /XValues [ ... ] /YValues [ ... ]   ticks exactly here instead of round numbers
%    /XNames [ (a) (b) ... ]   names under evenly spaced slots instead of numbers
%    /XLabel (text) /YLabel (text) /Size s >> plotaxes -
/plotaxes {
  24 dict begin
    /ax-o exch def
    /ax-u ax-o /Draw 1 .opt 0 1 clamp def
    /ax-size ax-o /Size 2.1 vmin .opt def
    /ax-b plotbox def
    ax-b aload pop /ax-h exch def /ax-w exch def /ax-y exch def /ax-x exch def
    ax-u 0 gt {
      gsave
        theme /stroke get 0.6 mul setlinewidth /body ax-size face
        % y ticks and grid
        % [ v alpha ... ]: fixed ticks, round ones, or (/Fade) round ones that cross-fade
        ax-o /YValues known { [ ax-o /YValues get { 1 } forall ] } {
          /.plot .mine /y0 get /.plot .mine /y1 get ax-o /YTicks 5 .opt
          ax-o /Fade false .opt { fadeticks } { niceticks [ exch { 1 } forall ] } ifelse
        } ifelse
        /ax-tk exch def
        0 2 ax-tk length 1 sub { /ax-i exch def
          /ax-v ax-tk ax-i get def /ax-a ax-tk ax-i 1 add get ax-u mul def
          0 ax-v plotpoint /ax-ty exch def pop
          ax-o /Grid true .opt {
            gsave /line ink 0.28 ax-a mul setalpha
              newpath ax-x ax-ty moveto ax-w ax-u mul 0 rlineto stroke
            grestore
          } if
          /muted ink ax-a setalpha
          ax-x ax-size 0.6 mul sub ax-ty ax-size 0.34 mul sub moveto
          ax-v ax-o /Decimals 0 .opt fmtnum ax-o /Suffix () .opt strcat showright
        } for
        % x names or ticks
        ax-o /XNames known {
          /ax-names ax-o /XNames get def
          0 1 ax-names length 1 sub { /ax-i exch def
            /muted ink ax-u setalpha
            ax-x ax-i 0.5 add ax-names length div ax-w mul add  ax-y ax-size 1.5 mul sub moveto
            ax-names ax-i get showcenter
          } for
        } {
          ax-o /XTicks 5 .opt 0 gt ax-o /XValues known or {
            ax-o /XValues known { [ ax-o /XValues get { 1 } forall ] } {
              /.plot .mine /x0 get /.plot .mine /x1 get ax-o /XTicks 5 .opt
              ax-o /Fade false .opt { fadeticks } { niceticks [ exch { 1 } forall ] } ifelse
            } ifelse
            /ax-tk exch def
            0 2 ax-tk length 1 sub { /ax-i exch def
              /ax-v ax-tk ax-i get def
              ax-v 0 plotpoint pop /ax-tx exch def
              /muted ink ax-tk ax-i 1 add get ax-u mul setalpha
              ax-tx ax-y ax-size 1.5 mul sub moveto
              ax-v ax-o /XDecimals 0 .opt fmtfixed showcenter
            } for
          } if
        } ifelse
        % the axes themselves, drawn on
        /line ink 1 setalpha theme /stroke get setlinewidth 1 setlinecap
        newpath ax-x ax-y ax-h add moveto ax-x ax-y lineto ax-x ax-w add ax-y lineto
        0 ax-u trimpath stroke
        ax-u setalpha /muted ink
        ax-o /XLabel known {
          ax-x ax-w 2 div add ax-y ax-size 3.4 mul sub moveto ax-o /XLabel get showcenter
        } if
        ax-o /YLabel known {
          gsave ax-x ax-size 4.6 mul sub ax-y ax-h 2 div add translate 90 rotate
            0 0 moveto ax-o /YLabel get showcenter grestore
        } if
        1 setalpha
      grestore
    } if
  end
} bind def
% i n u stagger .growth -> ui    bar i of n's own progress when the whole is at u
/.growth {
  4 dict begin
    /gw-s exch def /gw-u exch def /gw-n exch def /gw-i exch def
    gw-u 1 gw-s add mul  gw-s gw-i gw-n 1 sub 1 max div mul sub 0 1 clamp /cubic-out ease
  end
} bind def
% role-or-array i .pickrole -> role     one role for all, or one per mark
/.pickrole {
  exch dup type /arraytype eq
    { dup 0 get type /nametype eq { exch 1 index length mod get } { exch pop } ifelse }
    { exch pop } ifelse
} bind def
% [v ...] opts bars -     columns across the plot frame
%   << /Grow u /Stagger 0.6 /Role /accent  (or /Roles [ ... ], one per bar)
%      /Gap 0.3 /Values true /Decimals 0 /Prefix () /Suffix ()
%      /Dim [i ...]  bars to draw muted (to make the others stand out)
%      /Accent [i ...]  the opposite: every bar muted but these
%      /Count true   value labels count up as the bars grow (by default they
%                    show the true value, fading in) >>
/bars {
  32 dict begin
    /bs-o exch def /bs-v exch def
    /bs-n bs-v length def
    /bs-u bs-o /Grow 1 .opt 0 1 clamp def
    plotbox aload pop /bs-h exch def /bs-w exch def /bs-y exch def /bs-x exch def
    /bs-slot bs-w bs-n div def
    /bs-bw bs-slot 1 bs-o /Gap 0.3 .opt sub mul def
    0 /.plot .mine /y0 get max 0 exch plotpoint /bs-base exch def pop
    /bs-size bs-o /Size 2.2 vmin .opt def
    gsave
      0 1 bs-n 1 sub { /bs-i exch def
        /bs-ui bs-i bs-n bs-u bs-o /Stagger 0.6 .opt .growth def
        bs-ui 0 gt {
          /bs-val bs-v bs-i get def
          0 bs-val bs-ui mul plotpoint /bs-top exch def pop
          /bs-bx bs-x bs-i bs-slot mul add bs-slot bs-bw sub 2 div add def
          bs-o /Roles known { bs-o /Roles get } { bs-o /Role /accent .opt } ifelse bs-i .pickrole
          false bs-o /Dim [] .opt { bs-i eq or } forall { pop /line } if
          bs-o /Accent known { true bs-o /Accent get { bs-i eq { pop false } if } forall { pop /line } if } if
          ink bs-bx bs-base bs-bw bs-top bs-base sub rectfill
          bs-o /Values true .opt {
            /fg ink bs-ui setalpha /title bs-size face
            bs-bx bs-bw 2 div add  bs-top bs-base ge { bs-top bs-size 0.5 mul add } { bs-top bs-size 1.2 mul sub } ifelse moveto
            bs-o /Prefix () .opt bs-val bs-o /Count false .opt { bs-ui mul } if bs-o /Decimals 0 .opt fmtnum strcat bs-o /Suffix () .opt strcat showcenter
            1 setalpha
          } if
        } if
      } for
    grestore
  end
} bind def
% [v ...] opts hbars -    rows down the plot frame, longest value to the
%   right; the x range of the frame is the value axis.
%   << /Grow u /Stagger 0.6 /Role /Roles /Gap 0.3 /Values true /Decimals 0
%      /Prefix () /Suffix () /Names [ (a) ... ]   written left of the bars
%      /Ranks [r ...]   the row each bar sits in (fractions slide between
%                       rows): `values ranks` orders them largest first >>
/hbars {
  32 dict begin
    /bs-o exch def /bs-v exch def
    /bs-n bs-v length def
    /bs-u bs-o /Grow 1 .opt 0 1 clamp def
    plotbox aload pop /bs-h exch def /bs-w exch def /bs-y exch def /bs-x exch def
    /bs-slot bs-h bs-o /Rows bs-n .opt div def
    /bs-bh bs-slot 1 bs-o /Gap 0.3 .opt sub mul def
    /bs-size bs-o /Size bs-bh 0.5 mul 3 vmin min .opt def
    /bs-ranks bs-o /Ranks [ 0 1 bs-n 1 sub { } for ] .opt def
    gsave
      newpath bs-x bs-size 40 mul sub bs-y bs-w bs-size 80 mul add bs-h rectclip
      0 1 bs-n 1 sub { /bs-i exch def
        /bs-ui bs-i bs-n bs-u bs-o /Stagger 0.6 .opt .growth def
        bs-ui 0 gt {
          /bs-val bs-v bs-i get def
          bs-val bs-ui mul 0 plotpoint pop /bs-end exch def
          /bs-by bs-y bs-h add bs-ranks bs-i get 1 add bs-slot mul sub bs-slot bs-bh sub 2 div add def
          bs-o /Roles known { bs-o /Roles get } { bs-o /Role /accent .opt } ifelse bs-i .pickrole
          ink bs-x bs-by bs-end bs-x sub 0 max bs-bh rectfill
          bs-ui setalpha
          bs-o /Names known {
            /fg ink /body bs-size face
            bs-x bs-size 0.5 mul sub bs-by bs-bh bs-size 0.72 mul sub 2 div add moveto
            bs-o /Names get bs-i get showright
          } if
          bs-o /Values true .opt {
            /fg ink /title bs-size face
            bs-end bs-size 0.4 mul add bs-by bs-bh bs-size 0.72 mul sub 2 div add moveto
            bs-o /Prefix () .opt bs-val bs-o /Count false .opt { bs-ui mul } if bs-o /Decimals 0 .opt fmtnum strcat bs-o /Suffix () .opt strcat show
          } if
          1 setalpha
        } if
      } for
    grestore
  end
} bind def
% [ [x y] ... ] plotline -     the current path becomes the line through the
%                              data points. `0 u trimpath stroke` draws it on.
/plotline {
  newpath
  0 exch { aload pop plotpoint 3 -1 roll dup 0 eq { pop moveto } { pop lineto } ifelse 1 } forall pop
} bind def
% [ y ... ] seriesline -       the same for values evenly spaced across the
%                              frame's x range
/seriesline { .aspoints plotline } bind def
% [ y ... ] or [ [x y] ... ] .aspoints -> [ [x y] ... ]    values become points
%   spread evenly across the frame's x range; points stay as they are
/.aspoints {
  dup length 0 gt { dup 0 get type /arraytype ne {
    4 dict begin
      /sl-v exch def /sl-n sl-v length def
      [ 0 1 sl-n 1 sub { /sl-i exch def
        [ /.plot .mine /x0 get /.plot .mine /x1 get /.plot .mine /x0 get sub sl-i sl-n 1 sub 1 max div mul add  sl-v sl-i get ]
      } for ]
    end
  } if } if
} bind def
% X Y .plotdata -> x y     canvas to data: plotpoint undone
/.plotdata {
  .plot begin
    y sub h div y1 y0 sub mul y0 add exch
    x sub w div x1 x0 sub mul x0 add exch
  end
} bind def
% [ operands ] proc /name .guarded -> results     run proc on a word's
%   operands, packed in an array. If it fails, end the dictionaries it
%   began and raise the error again as from /name, so a caller that stops
%   the error finds the dictionary stack as it was. The words that use it
%   change the graphics state only inside a gsave in which nothing can fail.
/.guarded {
  countdictstack /.gs 5 -2 roll stopped {
    { /.gs eq { exit } if } loop
    { countdictstack 1 index gt { end } { exit } ifelse } loop pop
    errordict $error /errorname get get exec
  } {
    0 { dup 1 add index /.gs eq { exit } if 1 add } loop
    dup 3 add exch roll pop pop pop
  } ifelse
} bind def
% [ [x y] ... ] x lineat -> y     the line through the points, read at data
%   x: straight between points, the end value beyond either end. The
%   points must be in increasing x (equal x is a step), and there must be
%   at least one: otherwise it is a rangecheck.
/lineat { 2 array astore { aload pop .lineat } /lineat .guarded } bind def
/.lineat {
  8 dict begin
    /la-x exch def /la-p exch .aspoints def
    /la-n la-p length def
    la-n 0 eq { /lineat errordict /rangecheck get exec } if
    1 1 la-n 1 sub { /la-i exch def
      la-p la-i get 0 get la-p la-i 1 sub get 0 get lt { /lineat errordict /rangecheck get exec } if
    } for
    la-x la-p 0 get 0 get le { la-p 0 get 1 get } {
      la-x la-p la-n 1 sub get 0 get ge { la-p la-n 1 sub get 1 get } {
        0
        % the first point at or past x; the one before it is short of x,
        % so the interval between them is never empty
        1 1 la-n 1 sub { /la-i exch def
          la-p la-i get 0 get la-x ge {
            pop
            la-p la-i 1 sub get aload pop /la-ya exch def /la-xa exch def
            la-p la-i get aload pop /la-yb exch def /la-xb exch def
            la-x la-xa sub la-xb la-xa sub div la-yb la-ya sub mul la-ya add
            exit
          } if
        } for
      } ifelse
    } ifelse
  end
} bind def
% - plotarea -     close the current line down to the bottom of the frame,
%                  for filling under a curve
/plotarea {
  currentpoint pop /.plot .mine /y get lineto
  /.plot .mine /x get /.plot .mine /y get lineto closepath
} bind def
% [ [x y] ... ] u radius dots -     a dot at each point, popping in one
%                                   after another as u goes 0 to 1
/dots {
  8 dict begin
    /dt-r exch def /dt-u exch def /dt-p exch def
    0 1 dt-p length 1 sub { /dt-i exch def
      /dt-ui dt-i dt-p length dt-u 1.0 .growth def
      dt-ui 0 gt {
        dt-p dt-i get aload pop plotpoint dt-r dt-ui /back-out ease mul disc
      } if
    } for
  end
} bind def
% [v ...] box opts donut -     a ring of shares, swept on clockwise from the top
%   << /Grow u /Roles [ ... ] /Inner 0.62 /Gap 2 /Center (text) /CenterRole /fg >>
/donut {
  24 dict begin
    /dn-o exch def
    aload pop /dn-h exch def /dn-w exch def /dn-y exch def /dn-x exch def
    /dn-v exch def
    /dn-u dn-o /Grow 1 .opt 0 1 clamp /cubic-inout ease def
    /dn-r dn-w dn-h min 2 div def
    /dn-ri dn-r dn-o /Inner 0.62 .opt mul def
    /dn-cx dn-x dn-w 2 div add def /dn-cy dn-y dn-h 2 div add def
    /dn-tot 0 dn-v { add } forall def
    /dn-a 90 def
    /dn-gap dn-o /Gap 2 .opt def
    gsave
      0 1 dn-v length 1 sub { /dn-i exch def
        /dn-sw dn-v dn-i get dn-tot div 360 mul dn-u mul def
        dn-sw dn-gap gt {
          dn-o /Roles chartroles .opt dn-i .pickrole ink
          newpath
          dn-cx dn-cy dn-r  dn-a dn-gap 2 div sub  dn-a dn-sw sub dn-gap 2 div add  arcn
          dn-cx dn-cy dn-ri dn-a dn-sw sub dn-gap 2 div add  dn-a dn-gap 2 div sub  arc
          closepath fill
        } if
        /dn-a dn-a dn-sw sub def
      } for
      dn-o /Center known dn-u 0 gt and { dn-u setalpha
        dn-o /CenterRole /fg .opt ink
        dn-o /Center get [ dn-cx dn-ri 0.8 mul sub dn-cy dn-ri 0.3 mul sub dn-ri 1.6 mul dn-ri 0.6 mul ] /title fitface
        dn-o /Center get [ dn-cx dn-ri sub dn-cy dn-ri sub dn-ri 2 mul dn-ri 2 mul ] /c showin 1 setalpha
      } if
    grestore
  end
} bind def

% proc inplot -        run proc clipped to the plot frame: for lines whose
%                      data leaves the range (always, when the range is animated)
/inplot { gsave newpath plotbox boxpath clip newpath exec grestore } bind def
% << /Y v (or /X v) /Label (text) /Draw u /Dash true /Role /muted /Size s >> plotrule -
%                      a reference line across the frame at a data value
/plotrule {
  16 dict begin
    /pr-o exch def
    /pr-u pr-o /Draw 1 .opt 0 1 clamp def
    /pr-size pr-o /Size 2.1 vmin .opt def
    pr-u 0 gt {
      gsave
        pr-o /Role /muted .opt ink theme /stroke get 0.6 mul setlinewidth
        newpath
        pr-o /Y known {
          /.plot .mine /x0 get pr-o /Y get plotpoint moveto /.plot .mine /x1 get pr-o /Y get plotpoint lineto
        } {
          pr-o /X get /.plot .mine /y0 get plotpoint moveto pr-o /X get /.plot .mine /y1 get plotpoint lineto
        } ifelse
        gsave pr-o /Dash true .opt { [ pr-size 0.35 mul dup ] 0 setdash } if 0 pr-u trimpath stroke grestore
        pr-o /Label known {
          pr-u setalpha /body pr-size face
          pr-o /Y known {
            /.plot .mine /x1 get pr-o /Y get plotpoint pr-size 0.35 mul add moveto pr-o /Label get showright
          } {
            pr-o /X get /.plot .mine /y1 get plotpoint pr-size 0.9 mul sub exch pr-size 0.4 mul add exch moveto pr-o /Label get show
          } ifelse
          1 setalpha
        } if
      grestore
    } if
    newpath
  end
} bind def
% x y opts plotmark -      mark a data point: a dot, dashed drop lines to
%   the axes, and a label on a leader.
%   << /Label (text) /Side /ne /Draw u /Drop true /Role /accent /Radius r /Size s >>
/plotmark {
  16 dict begin
    /pm-o exch def /pm-y exch def /pm-x exch def
    /pm-u pm-o /Draw 1 .opt 0 1 clamp def
    /pm-size pm-o /Size 3 vmin .opt def
    /pm-r pm-o /Radius 0.9 vmin .opt def
    pm-u 0 gt {
      gsave
        pm-o /Drop true .opt {
          /muted ink theme /stroke get 0.5 mul setlinewidth [ pm-size 0.3 mul dup ] 0 setdash
          newpath pm-x pm-y plotpoint moveto pm-x /.plot .mine /y0 get plotpoint lineto
          pm-x pm-y plotpoint moveto /.plot .mine /x0 get pm-y plotpoint lineto
          0 pm-u 2 mul 1 min trimeach stroke [] 0 setdash
        } if
        pm-o /Role /accent .opt ink
        pm-x pm-y plotpoint pm-u 3 mul 1 min /back-out ease pm-r mul disc
        pm-o /Label known {
          /body pm-size face theme /stroke get 0.6 mul setlinewidth
          pm-o /Label get [ pm-x pm-y plotpoint 0 0 ] pm-r neg inset pm-o /Side /ne .opt pm-u 0.3 sub 0.7 div 0 1 clamp note
        } if
      grestore
    } if
  end
} bind def

% [y ...] gap lo hi .spread -> [y' ...]     move values apart until each is
%   at least gap from its neighbours, keeping their order, moving them as
%   little as possible (least squares: pool adjacent violators on y - k gap)
%   and keeping them in lo..hi. When they cannot all fit at that gap, the
%   gap shrinks evenly to fit (so crowded names overlap rather than leave
%   the range). While the values keep their order the result moves
%   continuously with them; where two values cross, they trade places.
/.spread {
  20 dict begin
    /sp-hi exch def /sp-lo exch def /sp-g exch def /sp-y exch def
    /sp-n sp-y length def
    sp-n 1 gt { /sp-g sp-hi sp-lo sub sp-n 1 sub div sp-g min 0 max def } if
    % the order, by value (insertion sort: a chart has a few labels)
    /sp-ix [ 0 1 sp-n 1 sub { } for ] def
    1 1 sp-n 1 sub { /sp-j exch def
      { sp-j 0 gt { sp-y sp-ix sp-j 1 sub get get sp-y sp-ix sp-j get get gt } { false } ifelse
        { /sp-a sp-ix sp-j 1 sub get def
          sp-ix sp-j 1 sub sp-ix sp-j get put sp-ix sp-j sp-a put
          /sp-j sp-j 1 sub def } { exit } ifelse
      } loop
    } for
    % blocks of (sum, count) whose means never decrease
    /sp-bs sp-n array def /sp-bc sp-n array def /sp-nb 0 def
    0 1 sp-n 1 sub { /sp-k exch def
      sp-bs sp-nb sp-y sp-ix sp-k get get sp-k sp-g mul sub put
      sp-bc sp-nb 1 put
      /sp-nb sp-nb 1 add def
      { sp-nb 2 ge {
          sp-bs sp-nb 2 sub get sp-bc sp-nb 2 sub get div
          sp-bs sp-nb 1 sub get sp-bc sp-nb 1 sub get div gt } { false } ifelse
        { sp-bs sp-nb 2 sub 2 copy get sp-bs sp-nb 1 sub get add put
          sp-bc sp-nb 2 sub 2 copy get sp-bc sp-nb 1 sub get add put
          /sp-nb sp-nb 1 sub def } { exit } ifelse
      } loop
    } for
    % each block at its mean, clamped, and back in the caller's order
    /sp-top sp-hi sp-n 1 sub sp-g mul sub sp-lo max def
    /sp-out sp-n array def /sp-k 0 def
    0 1 sp-nb 1 sub { /sp-b exch def
      /sp-m sp-bs sp-b get sp-bc sp-b get div sp-lo max sp-top min def
      sp-bc sp-b get { sp-out sp-ix sp-k get sp-m sp-k sp-g mul add put /sp-k sp-k 1 add def } repeat
    } for
    sp-out
  end
} bind def
% pts u .lineend -> [X Y] p     where a (non-empty) line's drawn part ends
%   on the canvas, and how much of it is drawn: u as for `0 u trimpath`, or
%   a dictionary << /X x >> for a line drawn up to data x (p is then the
%   fraction of its x range; a line with no x range, one point, is drawn
%   once x reaches it).
/.lineend {
  10 dict begin
    /le-u exch def /le-p exch .aspoints def
    /le-a le-p 0 get def /le-z le-p le-p length 1 sub get def
    le-u type /dicttype eq {
      /le-x le-u /X get def
      /le-span le-z 0 get le-a 0 get sub def
      le-span 0 lt { /lineat errordict /rangecheck get exec } if
      le-span 0 gt {
        /le-x le-x le-a 0 get max le-z 0 get min def
        [ le-x le-p le-x .lineat plotpoint ]
        le-x le-a 0 get sub le-span div
      } {
        [ le-z aload pop plotpoint ] le-x le-a 0 get ge { 1 } { 0 } ifelse
      } ifelse
    } {
      /le-u le-u 0 1 clamp def
      le-u 1e-6 le { [ le-a aload pop plotpoint ] } {
        le-u 1 ge { [ le-z aload pop plotpoint ] } {
          % a path of no length keeps no point when trimmed: it is its start
          le-p plotline 0 le-u trimpath
          { currentpoint } stopped { [ le-a aload pop plotpoint ] } { [ 3 1 roll ] } ifelse
          newpath
        } ifelse
      } ifelse
      le-u
    } ifelse
  end
} bind def
% /role-or-font size .fontof -> font     the font `face` would select
/.fontof { exch dup theme exch known { theme exch get } if findfont exch scalefont } bind def
% [ pts ... ] [ (name) ... ] opts serieslabels -     each series named at
%   the end of its line, in the line's colour, the names kept clear of
%   each other. Written right of the plot frame's box: leave room there.
%   An empty series is skipped.
%   << /Roles chartroles (line i is in role i; stroke it in the same)
%      /Draw u (or [u ...]: how much of each line is drawn, as for
%               `0 u trimpath`) /X x (or: the lines are drawn up to data x)
%      /Ride false (true: the name rides the drawn end; otherwise it fades
%                   in at the line's end as the line completes)
%      /Size 3 vmin /Face /title /Gap 1.2 x Size (between baselines)
%      /Pad 0.7 x Size (from the line's end) /Leader true >>
/serieslabels { 3 array astore { aload pop .serieslabels } /serieslabels .guarded } bind def
/.serieslabels {
  32 dict begin
    /lb-o exch def /lb-names exch def /lb-s exch def
    /lb-n lb-s length def
    /lb-size lb-o /Size 3 vmin .opt def
    /lb-roles lb-o /Roles chartroles .opt def
    /lb-ride lb-o /Ride false .opt def
    /lb-gap lb-o /Gap lb-size 1.2 mul .opt def
    /lb-pad lb-o /Pad lb-size 0.7 mul .opt def
    /lb-lead lb-o /Leader true .opt def
    /lb-font lb-o /Face /title .opt lb-size .fontof def
    /lb-lw theme /stroke get 0.6 mul def
    /lb-bx plotbox def
    /lb-at [ lb-n { [0 0] } repeat ] def /lb-al [ lb-n { 0 } repeat ] def
    /lb-rgb lb-n array def /lb-on [ lb-n { false } repeat ] def
    % everything that can fail happens here, before anything is drawn
    0 1 lb-n 1 sub { /lb-i exch def
      lb-s lb-i get .aspoints length 0 gt {
        lb-on lb-i true put
        lb-names lb-i get type /stringtype ne { /serieslabels errordict /typecheck get exec } if
        lb-rgb lb-i
          [ lb-roles dup type /arraytype eq { dup 0 get type /nametype eq 1 index 0 get type /arraytype eq or { lb-i 1 index length mod get } if } if rgbof ]
        put
        lb-s lb-i get
        lb-o /X known { lb-o } { lb-o /Draw 1 .opt dup type /arraytype eq { lb-i get } if } ifelse
        .lineend
        lb-ride not { exch pop lb-s lb-i get 1 .lineend pop exch } if
        % the visible amount: riding, as soon as drawn; otherwise over the last 15%
        lb-ride { 0.04 div } { 0.85 sub 0.15 div } ifelse 0 1 clamp
        lb-al lb-i 3 -1 roll put lb-at lb-i 3 -1 roll put
      } if
    } for
    % kept apart: all of them, where they will end; riding, the ones drawn
    /lb-k [ 0 1 lb-n 1 sub { dup lb-on exch get 1 index lb-al exch get 0 gt lb-ride not or and not { pop } if } for ] def
    /lb-cy lb-n array def
    lb-k length 0 gt {
      [ lb-k { lb-at exch get 1 get } forall ] lb-gap lb-bx 1 get lb-bx 1 get lb-bx 3 get add .spread
      0 1 lb-k length 1 sub { /lb-j exch def lb-cy lb-k lb-j get 2 index lb-j get put } for pop
    } if
    gsave
      lb-font setfont lb-lw setlinewidth 1 setlinecap
      lb-k { /lb-i exch def
        /lb-a lb-al lb-i get def
        lb-a 0 gt {
          lb-at lb-i get aload pop /lb-y exch def /lb-x exch def
          /lb-c lb-cy lb-i get def
          lb-rgb lb-i get aload pop setrgbcolor
          lb-a setalpha
          lb-lead {
            /lb-off lb-c lb-y sub abs lb-size 0.2 mul sub lb-size 0.3 mul div 0 1 clamp def
            lb-off 0 gt {
              lb-off lb-a mul setalpha
              newpath lb-x lb-pad 0.2 mul add lb-y moveto lb-x lb-pad 0.8 mul add lb-c lineto stroke
              lb-a setalpha
            } if
          } if
          lb-x lb-pad add lb-c lb-size 0.36 mul sub moveto lb-names lb-i get show
        } if
      } forall
    grestore
    newpath
  end
} bind def
% pts x opts tracer -     a point riding a series at data x, with its
%   reading: a dot on the line (straight between data points), a dashed
%   drop to the x axis, and the value beside it. An empty series draws
%   nothing.
%   << /Along false (true: x is the drawn fraction of the line, as for
%                    `0 u trimpath`, and the tracer leads the pen)
%      /Role /accent /Radius 0.9 vmin /Size 3 vmin /Draw u (brought in)
%      /Decimals 0 /Prefix () /Suffix () (the value, as fmtnum writes it)
%      /XDecimals n (also write x before it, as fmtfixed does: a year; the
%                    value is then read at x as written, so the pair is true)
%      /Drop true /Readout true /Plate true (a backing under the readout, in /bg) >>
/tracer { 3 array astore { aload pop .tracer } /tracer .guarded } bind def
/.tracer {
  32 dict begin
    /tr-o exch def /tr-x exch def /tr-p exch .aspoints def
    /tr-u tr-o /Draw 1 .opt 0 1 clamp def
    tr-p length 0 gt tr-u 0 gt and {
      % everything that can fail happens here, before anything is drawn
      tr-o /Along false .opt {
        tr-p tr-x .lineend pop aload pop .plotdata
      } {
        tr-x tr-p 0 get 0 get max tr-p tr-p length 1 sub get 0 get min
        dup tr-p exch .lineat
      } ifelse
      /tr-y exch def /tr-x exch def
      /tr-size tr-o /Size 3 vmin .opt def
      /tr-r tr-o /Radius 0.9 vmin .opt def
      tr-x tr-y plotpoint /tr-Y exch def /tr-X exch def
      /tr-base plotbox 1 get def /tr-right plotbox dup 0 get exch 2 get add def
      /tr-drop tr-o /Drop true .opt def /tr-read tr-o /Readout true .opt def
      /tr-plate tr-o /Plate true .opt def
      /tr-lw theme /stroke get 0.5 mul def
      /tr-k tr-u 3 mul 1 min /back-out ease def
      /tr-ra tr-u 0.3 sub 0.7 div 0 1 clamp def
      /tr-muted [ /muted rgbof ] def /tr-bg [ /bg rgbof ] def /tr-fg [ /fg rgbof ] def
      /tr-role [ tr-o /Role /accent .opt rgbof ] def
      /tr-fb /body tr-size 0.8 mul .fontof def /tr-ft /title tr-size .fontof def
      % with x written, the value is the one at x as written: a true pair
      /tr-ry tr-y def /tr-t () def
      tr-o /XDecimals known {
        /tr-xr 10 tr-o /XDecimals get exp dup tr-x mul round exch div def
        /tr-ry tr-p tr-xr .lineat def
        /tr-t tr-xr tr-o /XDecimals get fmtfixed (  ) strcat def
      } if
      /tr-v tr-o /Prefix () .opt tr-ry tr-o /Decimals 0 .opt fmtnum strcat tr-o /Suffix () .opt strcat def
      tr-t type /stringtype ne tr-v type /stringtype ne or { /tracer errordict /typecheck get exec } if
      gsave
        tr-drop {
          tr-muted aload pop setrgbcolor tr-lw setlinewidth [ tr-size 0.3 mul dup ] 0 setdash
          newpath tr-X tr-Y moveto tr-X tr-base lineto 0 tr-u trimpath stroke [] 0 setdash
        } if
        tr-bg aload pop setrgbcolor tr-X tr-Y tr-r 1.6 mul tr-k mul disc
        tr-role aload pop setrgbcolor tr-X tr-Y tr-r tr-k mul disc
        tr-read {
          tr-fb setfont /tr-w1 tr-t stringwidth pop def
          tr-ft setfont /tr-w tr-w1 tr-v stringwidth pop add def
          % above and to the right, or to the left where the frame ends
          /tr-lx tr-X tr-r 1.8 mul add def
          tr-lx tr-w add tr-right gt { /tr-lx tr-X tr-r 1.8 mul sub tr-w sub def } if
          tr-plate {
            tr-bg aload pop setrgbcolor tr-ra 0.82 mul setalpha
            [ tr-lx tr-size 0.3 mul sub tr-Y tr-r 1.8 mul add tr-size 0.3 mul sub
              tr-w tr-size 0.6 mul add tr-size 1.25 mul ] tr-size 0.25 mul roundpath fill
          } if
          tr-ra setalpha
          tr-lx tr-Y tr-r 1.8 mul add moveto
          tr-muted aload pop setrgbcolor tr-fb setfont tr-t show
          tr-fg aload pop setrgbcolor tr-ft setfont tr-v show
        } if
      grestore
    } if
    newpath
  end
} bind def

% --- dashboards ----------------------------------------------------------------
% Panels for live and recorded telemetry. Each takes numbers (a value, an
% array, a matrix) and a box and draws; none owns a clock or reads a
% signal, so a value comes from `signal`, `signalseries`, a tween or an
% array alike. Colours are roles, so a dashboard follows the theme.

% v [ role v1 role v2 role ... ] thresholdrole -> role
%   the role for a value: the first role below v1, the next from v1 up, ...
%   [ /good 70 /warn 90 /bad ] is green, amber from 70, red from 90.
/thresholdrole {
  4 dict begin
    /th-s exch def /th-v exch def
    /th-r th-s 0 get def
    1 2 th-s length 2 sub { /th-i exch def
      th-v th-s th-i get ge { /th-r th-s th-i 1 add get def } if
    } for
    th-r
  end
} bind def
% [v ...] .minmax -> lo hi
/.minmax { dup 0 get exch dup 0 get exch { dup 3 1 roll max 3 1 roll min exch } forall } bind def
% [v ...] box opts sparkline -     a small line chart filling the box: no axes
%   << /Range [lo hi] (the data's own, padded) /Role /accent2 /Fill 0.18
%      /Width w /Dot true /Draw u (the part drawn, from the left)
%      /From 0 /To 1 (where the first and last values sit, as fractions of the
%      box's width; outside the box is clipped: for a window read on a fixed
%      grid that slides by part of a step) >>
/sparkline {
  20 dict begin
    /sk-o exch def /sk-b exch def /sk-v exch def
    sk-v length 2 ge {
      sk-o /Range known { sk-o /Range get aload pop } {
        sk-v .minmax 2 copy sub abs 1e-9 lt { 1 add exch 1 sub exch } if
        2 copy exch sub 0.12 mul dup 3 1 roll add 3 1 roll sub exch
      } ifelse
      /sk-hi exch def /sk-lo exch def
      /sk-u sk-o /Draw 1 .opt 0 1 clamp def
      sk-b aload pop /sk-h exch def /sk-w exch def /sk-y exch def /sk-x exch def
      /sk-a sk-x sk-w sk-o /From 0 .opt mul add def
      /sk-z sk-x sk-w sk-o /To 1 .opt mul add def
      /sk-pts sk-v [ sk-a sk-y sk-z sk-a sub sk-h ] [ sk-lo sk-hi ] seriespoints def
      sk-o /Role /accent2 .opt ink
      gsave
        newpath sk-x sk-y sk-h sub sk-w sk-u mul sk-h 3 mul rectclip
        sk-o /Fill 0.18 .opt dup 0 gt {
          gsave setalpha sk-pts polypath sk-z sk-y lineto sk-a sk-y lineto closepath fill grestore
        } { pop } ifelse
        sk-o /Width theme /stroke get 0.7 mul .opt setlinewidth 1 setlinejoin 1 setlinecap
        sk-pts polypath stroke
      grestore
      sk-o /Dot true .opt {
        sk-x sk-w sk-u mul add dup
        sk-a sub sk-z sk-a sub 1e-9 max div sk-v length 1 sub mul sk-v exch valueat
        sk-lo sub sk-hi sk-lo sub div 0 1 clamp sk-h mul sk-y add
        sk-o /Width theme /stroke get 0.7 mul .opt 1.5 mul disc
      } if
    } if
  end
} bind def
% [v ...] box opts horizon -     a horizon chart: the series folded into
%   bands of colour, so a row a few pixels high still shows its shape.
%   Values above /Base fill up from the bottom in /Role, darkest where
%   highest; values below hang from the top in /NegRole.
%   << /Extent e (the largest |v - base| in the data) /Bands 3 /Base 0
%      /Role /accent2 /NegRole /accent3 /Ground /surface (the colour bands rise from)
%      /Mirror false (negatives from the bottom too) /Draw u (the part drawn, from the left) >>
/horizon {
  20 dict begin
    /hz-o exch def /hz-b exch def /hz-v exch def
    hz-v length 2 ge {
      /hz-n hz-o /Bands 3 .opt cvi 1 max def
      /hz-base hz-o /Base 0 .opt def
      hz-v .minmax /hz-max exch def /hz-min exch def
      /hz-e hz-o /Extent hz-max hz-base sub hz-base hz-min sub max 1e-9 max .opt def
      /hz-step hz-e hz-n div def
      /hz-u hz-o /Draw 1 .opt 0 1 clamp def
      hz-b aload pop /hz-h exch def /hz-w exch def /hz-y exch def /hz-x exch def
      /hz-g hz-o /Ground /surface .opt def
      gsave
        newpath hz-x hz-y hz-w hz-u mul hz-h rectclip
        % above the base, from the bottom
        hz-max hz-base gt {
          0 1 hz-n 1 sub { /hz-k exch def
            hz-max hz-base hz-k hz-step mul add gt {
              hz-g hz-o /Role /accent2 .opt 0.3 0.7 hz-k 1 add mul hz-n div add mixink ink
              hz-v hz-b [ hz-base hz-k hz-step mul add dup hz-step add ] seriespoints polypath
              hz-x hz-w add hz-y lineto hz-x hz-y lineto closepath fill
            } if
          } for
        } if
        % below it, hanging from the top (or rising from the bottom, mirrored)
        hz-min hz-base lt {
          /hz-nb hz-o /Mirror false .opt { hz-b } { [ hz-x hz-y hz-h add hz-w hz-h neg ] } ifelse def
          /hz-ey hz-nb 1 get def
          0 1 hz-n 1 sub { /hz-k exch def
            hz-min hz-base hz-k hz-step mul sub lt {
              hz-g hz-o /NegRole /accent3 .opt 0.3 0.7 hz-k 1 add mul hz-n div add mixink ink
              hz-v hz-nb [ hz-base hz-k hz-step mul sub dup hz-step sub ] seriespoints polypath
              hz-x hz-w add hz-ey lineto hz-x hz-ey lineto closepath fill
            } if
          } for
        } if
      grestore
    } if
  end
} bind def
% [[v ...] ...] box opts heatmap -     a matrix of cells, first row at the
%   top, coloured from the low role to the high one.
%   << /Range [lo hi] (the data's) /Roles [ /surface /accent ] (low high, or
%      low mid high) /Gap g /Draw u (columns brought in from the left) >>
/heatmap {
  24 dict begin
    /hm-o exch def /hm-b exch def /hm-m exch def
    /hm-nr hm-m length def
    hm-nr 0 gt {
      /hm-nc 0 hm-m { length max } forall def
      hm-o /Range known { hm-o /Range get aload pop } {
        hm-m 0 get 0 get dup hm-m { .minmax 3 -1 roll max 3 1 roll min exch } forall
      } ifelse
      /hm-hi exch def /hm-lo exch def
      /hm-roles hm-o /Roles [ /surface /accent ] .opt def
      /hm-gap hm-o /Gap 0.15 vmin .opt def
      /hm-u hm-o /Draw 1 .opt 0 1 clamp def
      hm-b aload pop /hm-h exch def /hm-w exch def /hm-y exch def /hm-x exch def
      /hm-cw hm-w hm-nc div def /hm-ch hm-h hm-nr div def
      0 1 hm-nr 1 sub { /hm-r exch def
        /hm-row hm-m hm-r get def
        0 1 hm-row length 1 sub { /hm-c exch def
          /hm-a hm-u hm-nc mul hm-c sub 0 1 clamp def
          hm-a 0 gt {
            hm-row hm-c get hm-lo sub hm-hi hm-lo sub 1e-9 max div 0 1 clamp
            hm-roles length 3 ge {
              dup 0.5 lt { 2 mul hm-roles 0 get hm-roles 1 get 3 -1 roll }
                         { 0.5 sub 2 mul hm-roles 1 get hm-roles 2 get 3 -1 roll } ifelse
            } { hm-roles 0 get hm-roles 1 get 3 -1 roll } ifelse
            mixink ink
            hm-a setalpha
            hm-x hm-c hm-cw mul add hm-gap 2 div add
            hm-y hm-h add hm-r 1 add hm-ch mul sub hm-gap 2 div add
            hm-cw hm-gap sub 0 max hm-ch hm-gap sub 0 max rectfill
            1 setalpha
          } if
        } for
      } for
    } if
  end
} bind def
% x y r role statuslight -     a lamp: a dot in the role with a soft halo
/statuslight {
  5 dict begin
    /sl-role exch def /sl-r exch def /sl-y exch def /sl-x exch def
    sl-role ink
    gsave
      0.12 setalpha sl-x sl-y sl-r 1.9 mul disc
      0.18 setalpha sl-x sl-y sl-r 1.4 mul disc
    grestore
    sl-x sl-y sl-r disc
    gsave 1 1 1 setrgbcolor 0.35 setalpha sl-x sl-r 0.3 mul sub sl-y sl-r 0.3 mul add sl-r 0.35 mul disc grestore
  end
} bind def
% box opts panel -> inner     a dashboard card: the theme's surface with
%   rounded corners and a title; returns the box left for its contents.
%   << /Title (text) /Status role (a lamp at the top right) /Fill /surface
%      /Size s (title size: a fifteenth of the card's width, at most a seventh of its height) /Pad p >>
/panel {
  12 dict begin
    /pn-o exch def /pn-b exch def
    pn-b aload pop /pn-h exch def /pn-w exch def /pn-y exch def /pn-x exch def
    /pn-size pn-o /Size pn-w 0.065 mul pn-h 0.14 mul min .opt def
    /pn-pad pn-o /Pad pn-size 1.1 mul .opt def
    pn-o /Fill /surface .opt ink pn-b theme /corner get pn-h 0.08 mul min roundpath fill
    pn-o /Title known {
      /muted ink /title pn-size face
      pn-x pn-pad add pn-y pn-h add pn-pad sub pn-size 0.72 mul sub moveto
      pn-o /Title get show
    } if
    pn-o /Status known {
      pn-x pn-w add pn-pad sub pn-size 0.3 mul sub pn-y pn-h add pn-pad sub pn-size 0.36 mul sub
      pn-size 0.3 mul pn-o /Status get statuslight
    } if
    [ pn-x pn-pad add pn-y pn-pad add pn-w pn-pad 2 mul sub
      pn-h pn-pad 2 mul sub pn-o /Title known { pn-size 1.5 mul sub } if 0 max ]
  end
} bind def
% v opts .fmtvalue -> (text)     /Short true (12.4k) or grouped (12,431), /Decimals
/.fmtvalue {
  dup /Decimals 0 .opt exch /Short false .opt { fmtshort } { fmtnum } ifelse
} bind def
% v box opts stattile -     a stat panel: a big number in its threshold's
%   colour, its unit, a change and a sparkline of its recent past.
%   << /Title (text) /Unit (%) /Decimals 0 /Short false (12.4k instead of 12,431)
%      /Thresholds [ /good 70 /warn 90 /bad ] (default: /fg)
%      /Delta d (a change to show: up or down arrow and the number) /DeltaDecimals 1
%      /DeltaSuffix (%) /DownIsGood false  /Spark [v ...] /SparkRange [lo hi] /SparkFrom 0 /SparkTo 1 (see sparkline's /From /To)
%      /Fill /surface, or /threshold to colour the card instead of the number >>
/stattile {
  24 dict begin
    /st-o exch def /st-b exch def /st-v exch def
    /st-role st-o /Thresholds known { st-v st-o /Thresholds get thresholdrole } { /fg } ifelse def
    /st-tint st-o /Fill /surface .opt /threshold eq def
    st-b st-o /Title known { << /Title st-o /Title get >> } { << >> } ifelse
      st-tint { dup /Fill /surface st-role 0.35 mixink put } if panel
    aload pop /st-h exch def /st-w exch def /st-y exch def /st-x exch def
    % the sparkline along the bottom, behind the number
    st-o /Spark known {
      st-o /Spark get [ st-x st-y st-w st-h 0.42 mul ]
      << /Role st-tint { /fg } { st-role dup /fg eq { pop /accent2 } if } ifelse /Fill 0.14
         st-o /SparkRange known { /Range st-o /SparkRange get } if
         /From st-o /SparkFrom 0 .opt /To st-o /SparkTo 1 .opt >> sparkline
    } if
    % the number and its unit
    /st-txt st-v st-o .fmtvalue def
    /st-unit st-o /Unit () .opt def
    /st-nb [ st-x st-y st-h 0.36 mul add st-w st-h 0.5 mul ] def
    /title 100 face
    /st-fs st-h 0.44 mul  st-w 0.9 mul st-txt stringwidth pop st-unit stringwidth pop 0.5 mul add 0.01 max div 100 mul min def
    st-tint { /fg } { st-role } ifelse ink /title st-fs face
    st-x st-y st-h 0.36 mul add moveto st-txt show
    /title st-fs 0.5 mul face /muted ink ( ) show st-unit show
    % the change, under the title at the right
    st-o /Delta known {
      /st-d st-o /Delta get def
      st-d 0 ge st-o /DownIsGood false .opt xor { /good } { /bad } ifelse
      st-d abs 1e-9 lt { pop /muted } if ink
      /st-ds st-h 0.13 mul st-fs 0.36 mul min def
      /body st-ds face
      /st-dt st-d abs st-o /DeltaDecimals 1 .opt fmtnum st-o /DeltaSuffix (%) .opt strcat def
      st-x st-w add st-dt stringwidth pop sub st-y st-h add st-ds sub moveto
      gsave currentpoint translate st-ds 0.9 mul neg st-ds 0.05 mul translate
        newpath st-d 0 ge { 0 0 moveto st-ds 0.7 mul 0 lineto st-ds 0.35 mul st-ds 0.62 mul lineto }
                     { 0 st-ds 0.62 mul moveto st-ds 0.7 mul st-ds 0.62 mul lineto st-ds 0.35 mul 0 lineto } ifelse
        closepath fill grestore
      st-dt show
    } if
  end
} bind def
% v box opts dial -     a gauge: an arc from the bottom left round to the
%   bottom right, filled to the value in its threshold's colour, with the
%   thresholds as a thin outer band and the number in the middle.
%   << /Range [0 100] /Thresholds [ /good 70 /warn 90 /bad ] /Sweep 240
%      /Thick 0.17 (of the radius) /Unit (%) /Decimals 0 /Short false /Label (text)
%      /Track /line >>
/dial {
  28 dict begin
    /dl-o exch def /dl-b exch def /dl-v exch def
    dl-o /Range [0 100] .opt aload pop /dl-hi exch def /dl-lo exch def
    /dl-th dl-o /Thresholds [ /accent ] .opt def
    /dl-sw dl-o /Sweep 240 .opt def
    dl-b aload pop /dl-h exch def /dl-w exch def /dl-y exch def /dl-x exch def
    % the arc's lowest point is r sin(90 + sweep/2) below the centre
    /dl-drop 90 dl-sw 2 div add sin neg 0 max def
    /dl-r dl-w 2 div dl-h 1 dl-drop add 1.12 mul div min 0.94 mul def
    /dl-cx dl-x dl-w 2 div add def
    /dl-cy dl-y dl-h dl-r 1 dl-drop add mul sub 2 div add dl-r dl-drop mul add def
    /dl-t dl-r dl-o /Thick 0.17 .opt mul def
    /dl-a0 90 dl-sw 2 div add def
    /dl-f dl-v dl-lo sub dl-hi dl-lo sub div 0 1 clamp def
    /dl-role dl-v dl-th thresholdrole def
    gsave
      0 setlinecap
      % track
      dl-o /Track /line .opt ink dl-t setlinewidth
      gsave 0.35 setalpha newpath dl-cx dl-cy dl-r dl-t 2 div sub dl-a0 dl-a0 dl-sw sub arcn stroke grestore
      % threshold band, just outside the track
      dl-t 0.22 mul setlinewidth
      /dl-ra dl-r dl-t 0.12 mul add def
      /dl-from dl-lo def
      0 2 dl-th length 1 sub { /dl-i exch def
        /dl-to dl-i 1 add dl-th length lt { dl-th dl-i 1 add get } { dl-hi } ifelse dl-hi min def
        dl-to dl-from gt {
          dl-th dl-i get ink
          newpath dl-cx dl-cy dl-ra
            dl-a0 dl-from dl-lo sub dl-hi dl-lo sub div dl-sw mul sub
            dl-a0 dl-to dl-lo sub dl-hi dl-lo sub div dl-sw mul sub arcn stroke
        } if
        /dl-from dl-to dl-lo max def
      } for
      % the value
      dl-f 0 gt {
        dl-role ink dl-t 0.78 mul setlinewidth
        newpath dl-cx dl-cy dl-r dl-t 2 div sub dl-a0 dl-a0 dl-sw dl-f mul sub arcn stroke
        % a bright cap at the tip
        dl-a0 dl-sw dl-f mul sub dup cos exch sin dl-r dl-t 2 div sub dup 3 1 roll mul 3 1 roll mul exch
        dl-cy add exch dl-cx add exch dl-t 0.24 mul /fg ink disc
      } if
      % the number
      /dl-txt dl-v dl-o .fmtvalue def
      /dl-unit dl-o /Unit () .opt def
      /title 100 face
      /dl-fs dl-r 0.5 mul  dl-r 1.25 mul dl-txt stringwidth pop dl-unit stringwidth pop 0.45 mul add 0.01 max div 100 mul min def
      /title dl-fs face
      dl-txt stringwidth pop
      /title dl-fs 0.45 mul face dl-unit stringwidth pop add
      /dl-tw exch def
      dl-role ink /title dl-fs face
      dl-cx dl-tw 2 div sub dl-cy dl-fs 0.3 mul sub moveto dl-txt show
      /muted ink /title dl-fs 0.45 mul face dl-unit show
      dl-o /Label known {
        /body dl-fs 0.32 mul face
        dl-cx dl-cy dl-r dl-drop mul sub dl-fs 0.1 mul add moveto dl-o /Label get showcenter
      } if
    grestore
  end
} bind def
