%!PS
% poem.ps: a template for "explain this short poem".
%
% The film: a heading, then the poem line by line, then a walk through it
% (each note marks a word or phrase in the poem and says what it does, in a
% card beside it; each note comes onto the card whole, one at a time), then
% a closing reading that stays on the finished picture. Its length follows
% from the text: more lines, more notes and longer notes make a longer
% film, up to 90 seconds.
%
% To use it: copy this file, change only the CONTENT block below, then
% `psanim check film.ps`, `psanim check film.ps --all` and
% `psanim sheet film.ps -o sheet.png` and look at the sheet. If content
% does not fit, `check` fails with a message that starts `content:` and
% names the field.
%
% Text is UTF-8: write it as it is, with curly quotes (’ “ ”) and accents
% (Bashō, café). A straight ' draws as a straight typewriter apostrophe.
% A character no face has (Japanese, Chinese, Korean, Thai, Arabic, the
% Indic scripts) draws as an empty box, and `psanim check` names it.
% The limits below count characters as written; the numbers in `check`'s
% messages count bytes, so an accented letter counts as two there.

% ============================ CONTENT: edit this ============================

% The theme, by name: /paper (warm white), /midnight (dark), /dusk (plum),
% /blueprint (deep blue), /poster (yellow), /terminal (green on black).
/look /paper def

% The heading: a few words, at most about 40 characters.
/heading (Issa’s snail) def

% Who wrote it, and where the text comes from: one line, at most about 45
% characters (about 35 in /terminal). () for none.
/poet (Kobayashi Issa, a literal rendering) def

% The poem: 2 to 6 lines, each at most about 45 characters, about 40 in
% the wider faces of /poster and 35 in /terminal (longer lines shrink the
% type; past a point `check` says so).
/poem [
  (little snail)
  (inch by inch, climb)
  (Mount Fuji!)
] def

% The walk: 1 to 5 notes, in the order they are explained. Each is
%   [ line (words) (kind) (what it does) ]
% line:         which line of /poem the words are in, counting from 0.
% words:        the word or phrase to mark; it must appear in that line
%               exactly as written there. At most about 30 characters.
%               The card shows them as written, in the accent colour,
%               with no quotation marks added.
% kind:         a label for the note, at most about 16 characters: image,
%               turn, sound, contrast, form ...
% what it does: one to three sentences, at most about 160 characters.
/notes [
  [ 0 (little snail) (image)
    (The smallest creature in the poem, named first and gently, as if the poet were talking to it.) ]
  [ 1 (inch by inch) (pace)
    (The line slows to the snail’s speed: short words, one step and then another.) ]
  [ 2 (Mount Fuji!) (turn)
    (The goal is the largest thing in Japan. The jump in scale is the joke, and the encouragement.) ]
] def

% The closing reading: what the poem adds up to, at most about 200
% characters. It stays on screen to the end.
/reading (A tiny effort set against a vast goal, and the poet cheers it on. Slow progress still climbs the mountain.) def

% ===================== nothing below here needs to change =====================

% A movie that places this file as a component can pass any of the content
% names in /Params; otherwise the values above are used.
/look /look look param def
/heading /heading heading param def
/poet /poet poet param def
/poem /poem poem param def
/notes /notes notes param def
/reading /reading reading param def

% ---- checks that need no fonts: counts, indexes, empty fields ---------------
/pm-fail { cvn errordict /rangecheck get exec } def              % (why) pm-fail
/pm-num { 12 string cvs } def
/pm-cat { 1 index length 1 index length add string
          dup 0 4 index putinterval dup 3 index length 3 index putinterval
          3 1 roll pop pop } def                                 % (a) (b) -> (ab)
/pm-join { () exch { dup type /stringtype ne { pm-num } if pm-cat } forall } def  % [ (a) 1 ] -> (a1)
/pm-cats { pm-join (content: ) exch pm-cat } def                 % [ ... ] -> (content: ...)
/pm-words { % (text) -> the number of words: runs of characters between spaces
  0 32 3 -1 roll { dup 32 gt 2 index 32 le and { 3 -1 roll 1 add 3 1 roll } if exch pop } forall pop } def
/pm-text { % value (field) -> fails unless value is a string with a word in it
  exch dup type /stringtype ne { pop true } { pm-words 0 eq } ifelse
    { [ exch ( must be text with at least one word in it) ] pm-cats pm-fail } { pop } ifelse } def
heading (/heading) pm-text
reading (/reading) pm-text
poet type /stringtype ne { [ (/poet must be text, or \(\) for none) ] pm-cats pm-fail } if
poem type /arraytype ne { [ (/poem must be an array of lines: [ \(one\) \(two\) ]) ] pm-cats pm-fail } if
notes type /arraytype ne { [ (/notes must be an array of notes) ] pm-cats pm-fail } if
poem length 2 lt poem length 6 gt or
  { [ (/poem has ) poem length ( lines; this template takes 2 to 6) ] pm-cats pm-fail } if
0 1 poem length 1 sub { /pm-j exch def poem pm-j get [ (line ) pm-j ( of /poem) ] pm-join pm-text } for
notes length 1 lt notes length 5 gt or
  { [ (/notes has ) notes length ( notes; this template takes 1 to 5) ] pm-cats pm-fail } if
0 1 notes length 1 sub { /pm-j exch def
  notes pm-j get dup type /arraytype ne { pop true } { length 4 ne } ifelse
    { [ (note ) pm-j ( of /notes is not [ line \(words\) \(kind\) \(what it does\) ]) ] pm-cats pm-fail } if
  notes pm-j get 0 get dup type /integertype eq { dup 0 lt exch poem length ge or } { pop true } ifelse
    { [ (note ) pm-j (: line must be a number from 0 to ) poem length 1 sub ] pm-cats pm-fail } if
  notes pm-j get 1 get [ (note ) pm-j (: the words) ] pm-join pm-text
  notes pm-j get 2 get [ (note ) pm-j (: kind) ] pm-join pm-text
  notes pm-j get 3 get [ (note ) pm-j (: what it does) ] pm-join pm-text
  poem notes pm-j get 0 get get notes pm-j get 1 get search
    { pop pop pop }
    { pop [ (note ) pm-j (: the words \() notes pm-j get 1 get (\) are not in line ) notes pm-j get 0 get ( of /poem) ] pm-cats pm-fail } ifelse
} for

% ---- time, from the text ------------------------------------------------------
% A note comes in whole: its kind, its words and its explanation fade in
% together in a quarter of a second, stay for as long as they take to read
% (0.24 s a word) and a second more, and fade out in a fifth of a second.
% The next note starts the moment the last has gone, so no frame shows two
% notes and at most two frames, while one is nearly gone and the other
% barely there, show neither; the card's frame and the rule under its kind
% stay throughout.
% The reading comes in the same way and stays: the finished picture holds,
% still, for its reading time and 2 s more, at least 3 s.
/pm-rate 0.24 def                                                % seconds a word
/pm-in 0.4 def                                                   % a line of the poem rising in
/pm-tin 0.25 def                                                 % card text fading in
/pm-tout 0.2 def                                                 % card text fading out
/pm-linegap { pm-words 0.25 mul 0.5 add } def                    % (line) -> gap before the next
/pm-notedurs [ notes { dup 1 get pm-words exch 3 get pm-words add
  pm-rate mul 1.0 add pm-tin add pm-tout add 3 max } forall ] def   % each note's time on the card
/pm-notestarts [ 0 pm-notedurs { 1 index add } forall ] def      % and when each starts; the last, the reading
/pm-walkdur pm-notestarts dup length 1 sub get def
/pm-leave 0.4 def                                                % the rules under the words leaving at the close
/pm-holddur reading pm-words pm-rate mul 2.0 add 3 max def       % the finished picture, still
/pm-closedur pm-leave pm-holddur add def
/pm-poemdur 0 poem { pm-linegap add } forall pm-in add 1.0 add def
/pm-total 0.25 pm-poemdur add pm-walkdur add pm-closedur add def
pm-total 90 gt { [ (the film would run ) pm-total cvi ( s; this template stops at 90 s: shorten the notes or the reading) ] pm-cats pm-fail } if
[ /open 0.25  /lines pm-poemdur  /walk pm-walkdur  /close pm-closedur ] storyboard

<< /Size [1280 720] /Duration storylength /FPS 30 >> animation
/pktype use
look usetheme

% ---- places: the heading in a band at the top, the poem and its card below --
/pm-page canvasbox 7 vmin inset def
/pm-head pm-page 0 0.86 1 0.14 subbox def
/pm-body pm-page 0 0 1 0.80 subbox def
pm-body 0.56 splitx /pm-side exch def /pm-left exch def
/pm-verse pm-left 0 0 0.94 1 subbox def                         % the poem's column
/pm-x pm-verse 0 get def

% the heading: modest, shrunk only if it is too wide
/heading-size 5 vmin def
/title heading-size face heading stringwidth pop pm-head 2 get gt
  { /heading-size heading-size pm-head 2 get mul heading stringwidth pop div def } if
heading-size 3.5 vmin lt { [ (/heading is too long; keep it under about 40 characters) ] pm-cats pm-fail } if

% the poem: one size for every line, as large as the longest allows
/pm-cap 8.5 vmin def  /pm-floor 4 vmin def  /pm-lead 1.6 def
/pm-size pm-cap def
/serif 100 face
poem { stringwidth pop 100 div 0.01 max pm-verse 2 get exch div pm-size min /pm-size exch def } forall
pm-size pm-verse 3 get poem length 1 add pm-lead mul div min /pm-size exch def
pm-size pm-floor lt {
  0 poem { length max } forall /pm-long exch def
  [ (a line of /poem is too long to set at a legible size; keep lines under about )
    pm-long pm-size mul pm-floor div cvi 1 max ( characters in this theme’s face \(the longest has ) pm-long (\)) ] pm-cats pm-fail
} if
/pm-step pm-size pm-lead mul def
/pm-poetsize pm-size 0.6 mul 3.2 vmin max 4 vmin min def                % under the poem, smaller than it
/body pm-poetsize face poet stringwidth pop 0.01 max pm-verse 2 get exch div pm-poetsize mul
  pm-poetsize min /pm-poetsize exch def
pm-poetsize 3.2 vmin lt { [ (/poet is too long; keep it under about 45 characters) ] pm-cats pm-fail } if
% the poem block, from the top of line 0 to the bottom of the attribution,
% centred in the body
/pm-poemh pm-size 0.72 mul poem length 1 sub pm-step mul add
  poet length 0 gt { pm-step 0.85 mul add pm-poetsize 0.3 mul add } if def
/pm-mid pm-body 1 get pm-body 3 get 2 div add def
/pm-y0 pm-mid pm-poemh 2 div add pm-size 0.72 mul sub def        % line 0's baseline
/pm-base { pm-step mul pm-y0 exch sub } def                      % i -> baseline y

% the card: the kind over a rule, the words it is about, then what they do
/pm-pad 3.5 vmin def
/pm-tagsize 3.5 vmin def   /pm-tagh pm-tagsize 2.1 mul def
/pm-quotesize 4.8 vmin def /pm-quoteh pm-quotesize 1.8 mul def
/pm-innerw pm-side 2 get pm-pad 2 mul sub def
/pm-roomh pm-body 3 get pm-pad 2 mul sub def                     % the most the card can hold inside
% the explanation at 4.6 vmin, smaller (down to 4) only if a note or the
% reading would not fit the card at that size
/pm-fits { % -> true if every note and the reading fit the card at pm-textsize
  /pm-lineh pm-textsize 1.38 mul def
  true
  notes { 3 get /body pm-textsize face pm-innerw wraplines length pm-lineh mul
          pm-tagh add pm-quoteh add pm-roomh le and } forall
  reading /body pm-textsize face pm-innerw wraplines length pm-lineh mul pm-tagh add pm-roomh le and } def
/pm-textsize 4.6 vmin def
{ pm-fits pm-textsize 4.05 vmin lt or { exit } if /pm-textsize pm-textsize 0.2 vmin sub def } loop
/pm-lineh pm-textsize 1.38 mul def
/pm-wrap { % (text) (field) -> [ (line) ... ], every line inside the card
  /pm-field exch def /body pm-textsize face pm-innerw wraplines
  dup { stringwidth pop pm-innerw gt
        { [ pm-field ( has a word too long for the card; break it up) ] pm-cats pm-fail } if } forall } def
/pm-notelines [ 0 1 notes length 1 sub { /pm-j exch def
  notes pm-j get 3 get [ (note ) pm-j (: what it does) ] pm-join pm-wrap } for ] def
/pm-readlines reading (/reading) pm-wrap def
/pm-qsizes [ 0 1 notes length 1 sub { /pm-j exch def                % each note's words, shrunk to fit
  /serif pm-quotesize face notes pm-j get 1 get stringwidth pop 0.01 max
  pm-innerw exch div pm-quotesize mul pm-quotesize min
  dup 3.4 vmin lt { [ (note ) pm-j (: the words are too long to quote on the card; mark fewer of them, at most about 30 characters) ] pm-cats pm-fail } if
} for ] def
0 1 notes length 1 sub { /pm-j exch def
  /title pm-tagsize face notes pm-j get 2 get stringwidth pop pm-innerw gt
    { [ (note ) pm-j (: kind is too long; keep it under about 16 characters) ] pm-cats pm-fail } if
} for
0 1 notes length 1 sub { /pm-j exch def
  pm-notelines pm-j get length pm-lineh mul pm-tagh add pm-quoteh add pm-roomh gt
    { [ (note ) pm-j (: what it does is too long for the card; keep it under about 160 characters) ] pm-cats pm-fail } if
} for
pm-readlines length pm-lineh mul pm-tagh add pm-roomh gt
  { [ (/reading is too long for the card; keep it under about 200 characters) ] pm-cats pm-fail } if
% as tall as its longest content, centred on the poem, inside the body
/pm-innerh pm-tagh pm-readlines length pm-lineh mul add
  pm-notelines { length pm-lineh mul pm-tagh add pm-quoteh add max } forall def
/pm-cardh pm-innerh pm-pad 2 mul add def
/pm-cardy pm-mid pm-cardh 2 div sub pm-body 1 get max def
pm-cardy pm-cardh add pm-body 1 get pm-body 3 get add gt
  { /pm-cardy pm-body 1 get pm-body 3 get add pm-cardh sub def } if
/pm-card [ pm-side 0 get pm-cardy pm-side 2 get pm-cardh ] def
/pm-top pm-cardy pm-cardh add pm-pad sub def                     % inside the card, at its top
/pm-cx pm-side 0 get pm-pad add def
/pm-tagy pm-top pm-tagsize 0.75 mul sub def                      % baselines on the card
/pm-ruley pm-top pm-tagsize 1.4 mul sub def                      % the rule under the kind
/pm-quotey pm-top pm-tagh sub pm-quotesize 0.75 mul sub def
/pm-texty { pm-lineh mul sub pm-textsize 0.75 mul sub } def      % top k -> baseline of line k

% ---- things at rest ----------------------------------------------------------
/pm-line { % i -> the poem's line i, set in its place
  /serif pm-size face dup pm-x exch pm-base moveto poem exch get show } def
/pm-wordbox { % note -> the box of its words in the poem
  /serif pm-size face dup 0 get pm-x exch pm-base moveto
  dup 0 get poem exch get exch 1 get partbox } def
/pm-mark { % note u -> the note's words in /accent, laid over the line at opacity u
  dup 0 gt { gsave setalpha dup pm-wordbox 0 get /pm-wx exch def /accent ink
    dup 0 get pm-base pm-wx exch moveto 1 get show grestore } { pop pop } ifelse } def
/pm-rule { % note u -> a rule drawn on under the note's words
  exch pm-wordbox 0 -0.9 vmin shifted exch /accent ink 0.45 vmin setlinewidth underline newpath } def
/pm-cardground { % the card, and the rule under the kind: they stay to the end
  /surface ink pm-card 2 vmin roundpath fill
  /line ink 0.15 vmin setlinewidth pm-card 2 vmin roundpath stroke
  pm-cx pm-ruley moveto pm-innerw 0 rlineto stroke } def
/pm-tag { /title pm-tagsize face /accent ink pm-cx pm-tagy moveto show } def   % (kind) -> on the card
/pm-lines { % lines top -> each line of the explanation in its place
  /pm-ly exch def /pm-k 0 def
  { /body pm-textsize face /fg ink pm-cx pm-ly pm-k pm-texty moveto show /pm-k pm-k 1 add def } forall } def
/pm-note { % j -> note j on the card, whole: its kind, its words as written, what they do
  /pm-nj exch def notes pm-nj get
  dup 2 get pm-tag
  1 get /serif pm-qsizes pm-nj get face /accent ink pm-cx pm-quotey moveto show
  pm-notelines pm-nj get pm-top pm-tagh sub pm-quoteh sub pm-lines } def
/pm-close { % the reading on the card, whole
  (reading) pm-tag pm-readlines pm-top pm-tagh sub pm-lines } def
/pm-alpha { % d -> the opacity of card text shown for d seconds: in, held, out
  dup pm-tout sub exch /cubic-in tween 1 exch sub
  0 pm-tin /cubic-out tween min } def

% ---- the film ----------------------------------------------------------------
/scene {
  ground
  % the heading arrives and stays: modest, top left
  /open { [/rise pm-in] { heading pm-head /title heading-size face /fg ink /w showin } entering } frombeat
  % the poem, a line at a time, then its attribution
  /lines {
    {
      0 1 poem length 1 sub { /pm-i exch def
        poem pm-i get pm-linegap { [/rise pm-in] { pm-i pm-line } entering } then
      } for
      0 { [/fade pm-in] { poet pm-x poem length 1 sub pm-base pm-step 0.85 mul sub moveto
                          /body pm-poetsize face /muted ink show } entering } then
    } script
  } frombeat
  % the card arrives with the first note and stays to the end
  /walk { /fade { pm-cardground } entering } frombeat
  /walk {
    % each note's words are underlined as it arrives; the rules stay until
    % the reading comes, then leave the poem clean
    0 1 notes length 1 sub { /pm-j exch def
      pm-notestarts pm-j get pm-walkdur pm-leave add {
        gsave pm-walkdur pm-notestarts pm-j get sub dup pm-leave add ramp 1 exch sub setalpha
        notes pm-j get 0.1 0.6 /cubic-out tween pm-rule grestore
      } during
    } for
    % each note: its words light up in the poem, and the card says why,
    % whole, then makes way for the next
    0 1 notes length 1 sub { /pm-j exch def
      pm-notestarts pm-j get dup pm-notedurs pm-j get add {
        notes pm-j get 0 0.4 ramp span 0.4 sub span ramp sub pm-mark
        gsave span pm-alpha setalpha pm-j pm-note grestore
      } during
    } for
  } frombeat
  % the reading, whole, on the finished picture
  /close { gsave 0 pm-tin /cubic-out tween setalpha pm-close grestore } frombeat
} def
