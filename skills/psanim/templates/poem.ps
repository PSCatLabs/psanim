%!PS
% poem.ps: a template for "explain this short poem".
%
% The film: a heading, then the poem line by line, then a walk through it
% (each note marks a word or phrase in the poem and says what it does, in a
% card beside it), then a closing reading that stays on the finished
% picture. Its length follows from the text: more lines, more notes and
% longer notes make a longer film.
%
% To use it: copy this file, change only the CONTENT block below, then
% `psanim check film.ps`, `psanim check film.ps --all` and
% `psanim sheet film.ps -o sheet.png` and look at the sheet. If content
% is too long to fit, `check` fails with a message naming the field.
%
% Text is ASCII: write "Basho", not the name with a macron, and straight
% quotes ("like this"). A non-ASCII character shows as a blank. (Curly
% quotes and accented letters will work once psanim's Unicode text lands;
% nothing here depends on it.)

% ============================ CONTENT: edit this ============================

% The theme, by name: /paper (warm white), /midnight (dark), /dusk (plum),
% /blueprint (deep blue), /poster (yellow), /terminal (green on black).
/look /paper def

% The heading: a few words, at most about 40 characters.
/heading (Issa's snail) def

% Who wrote it, and where the text comes from: one line, at most about 50
% characters. () for none.
/poet (Kobayashi Issa; a literal rendering for this template) def

% The poem: 2 to 6 lines, each at most about 45 characters (longer lines
% shrink the type; past a point `check` says which line is too long).
/poem [
  (little snail)
  (inch by inch, climb)
  (Mount Fuji!)
] def

% The walk: 1 to 5 notes, in the order they are explained. Each is
%   [ line (words) (kind) (what it does) ]
% line:         which line of /poem the words are in, counting from 0.
% words:        the word or phrase to mark; it must appear in that line
%               exactly as written there.
% kind:         a label for the note, at most about 16 characters: image,
%               turn, sound, contrast, form ...
% what it does: one to three sentences, at most about 160 characters.
/notes [
  [ 0 (little snail) (image)
    (The smallest creature in the poem, named first and gently, as if the poet were talking to it.) ]
  [ 1 (inch by inch) (pace)
    (The line slows to the snail's speed: short words, one step and then another.) ]
  [ 2 (Mount Fuji!) (turn)
    (The goal is the largest thing in Japan. The jump in scale is the joke, and the encouragement.) ]
] def

% The closing reading: what the poem adds up to, at most about 200
% characters. It stays on screen to the end.
/reading (A tiny effort set against a vast goal, and the poet cheers it on. Slow progress still climbs the mountain.) def

% ===================== nothing below here needs to change =====================

% A movie that places this file as a component can pass any of the content
% names in /Params; otherwise the values above are used.
/look /look look param def
/heading /heading heading param def
/poet /poet poet param def
/poem /poem poem param def
/notes /notes notes param def
/reading /reading reading param def

% ---- checks that need no fonts: counts and indexes ---------------------------
/pm-fail { cvn errordict /rangecheck get exec } def              % (why) pm-fail
/pm-num { 12 string cvs } def
/pm-cat { 1 index length 1 index length add string
          dup 0 4 index putinterval dup 3 index length 3 index putinterval
          3 1 roll pop pop } def                                 % (a) (b) -> (ab)
/pm-cats { (content: ) exch { dup type /stringtype ne { pm-num } if pm-cat } forall } def
poem length 2 lt poem length 6 gt or
  { [ (/poem has ) poem length ( lines; this template takes 2 to 6) ] pm-cats pm-fail } if
notes length 1 lt notes length 5 gt or
  { [ (/notes has ) notes length ( notes; this template takes 1 to 5) ] pm-cats pm-fail } if
0 1 notes length 1 sub { /pm-j exch def
  notes pm-j get length 4 ne
    { [ (note ) pm-j ( of /notes is not [ line \(words\) \(kind\) \(what it does\) ]) ] pm-cats pm-fail } if
  notes pm-j get 0 get dup type /integertype eq { dup 0 lt exch poem length ge or } { pop true } ifelse
    { [ (note ) pm-j (: line must be a number from 0 to ) poem length 1 sub ] pm-cats pm-fail } if
  poem notes pm-j get 0 get get notes pm-j get 1 get search
    { pop pop pop }
    { pop [ (note ) pm-j (: the words \() notes pm-j get 1 get (\) are not in line ) notes pm-j get 0 get ( of /poem) ] pm-cats pm-fail } ifelse
} for

% ---- time, from the text: reading takes 0.3 s a word and a second -----------
/pm-words { 1 exch { 32 eq { 1 add } if } forall } def           % (text) -> words
/pm-in 0.6 def                                                   % an entrance's length
/pm-linegap { pm-words 0.25 mul 0.5 add } def                    % (line) -> gap before the next
/pm-notedur { dup 1 get pm-words exch 3 get pm-words add 0.3 mul 1 add pm-in add 3.2 max } def
/pm-hold 2.5 def                                                 % the finished picture, still
/pm-poemdur 0 poem { pm-linegap add } forall pm-in add 1.2 add def
/pm-notesdur 0 notes { pm-notedur add } forall def
/pm-readdur reading pm-words 0.3 mul 1 add pm-in add pm-hold add def
[ /open 0.5  /lines pm-poemdur  /walk pm-notesdur  /close pm-readdur ] storyboard

<< /Size [1280 720] /Duration storylength /FPS 30 >> animation
/pktype use
look usetheme

% ---- places -------------------------------------------------------------------
/pm-page canvasbox 7 vmin inset def
/pm-head pm-page 0 0.86 1 0.14 subbox def
/pm-body pm-page 0 0 1 0.80 subbox def
pm-body 0.56 splitx /pm-side exch def /pm-left exch def
/pm-verse pm-left 0 0 0.94 1 subbox def                         % the poem's column

% ---- the poem: one size for every line, as large as the longest allows ------
/pm-cap 8 vmin def  /pm-floor 4 vmin def  /pm-lead 1.55 def
/pm-size pm-cap def
/serif 100 face
poem { stringwidth pop 100 div pm-verse 2 get exch div pm-size min /pm-size exch def } forall
pm-size pm-verse 3 get poem length pm-lead mul 1 add div min /pm-size exch def
pm-size pm-floor lt {
  0 poem { length max } forall /pm-long exch def
  [ (a line of /poem is too long to set at a legible size; keep lines under about )
    pm-verse 2 get pm-floor div 2.1 mul cvi ( characters \(the longest has ) pm-long (\)) ] pm-cats pm-fail
} if
/pm-step pm-size pm-lead mul def
% baselines: the block of lines centred in the column, the attribution under it
/pm-y0 pm-verse 1 get pm-verse 3 get 2 div add poem length 1 sub pm-step mul 2 div add pm-size 0.35 mul sub def
/pm-x pm-verse 0 get def
/pm-base { pm-step mul pm-y0 exch sub } def                      % i -> baseline y
/pm-poetsize 3.4 vmin def
/body pm-poetsize face poet stringwidth pop 1 max pm-verse 2 get exch div pm-poetsize mul
  pm-poetsize min /pm-poetsize exch def
pm-poetsize 3 vmin lt { [ (/poet is too long; keep it under about 50 characters) ] pm-cats pm-fail } if
/heading-size 5 vmin def
/title heading-size face heading stringwidth pop pm-head 2 get gt
  { /heading-size heading-size pm-head 2 get mul heading stringwidth pop div def } if
heading-size 3.5 vmin lt { [ (/heading is too long; keep it under about 40 characters) ] pm-cats pm-fail } if

% ---- the card: as tall as its longest content, centred on the poem ----------
/pm-pad 3.5 vmin def
/pm-tagsize 3.2 vmin def  /pm-tagh pm-tagsize 2.2 mul def        % the kind, and room under it
/pm-quotesize 4.6 vmin def  /pm-quoteh pm-quotesize 1.9 mul def  % the quoted words
/pm-textsize 3.8 vmin def  /pm-lineh pm-textsize 1.4 mul def     % the explanation
/pm-innerw pm-side 2 get pm-pad 2 mul sub def
/pm-nlines { /body pm-textsize face pm-innerw wraplines length } def   % (text) -> lines
/pm-qsizes notes length array def                               % each note's quote, shrunk to fit
/pm-roomfor pm-body 3 get pm-pad 2 mul sub def                   % the most the card can hold
/pm-noteh { 3 get pm-nlines pm-lineh mul pm-tagh add pm-quoteh add } def
0 1 notes length 1 sub { /pm-j exch def
  notes pm-j get pm-noteh pm-roomfor gt
    { [ (note ) pm-j (: what it does is too long for the card; keep it under about 160 characters) ] pm-cats pm-fail } if
  /title pm-tagsize face notes pm-j get 2 get stringwidth pop pm-innerw gt
    { [ (note ) pm-j (: kind is too long; keep it under about 16 characters) ] pm-cats pm-fail } if
  /serif pm-quotesize face notes pm-j get 1 get stringwidth pop 1.1 mul pm-innerw exch div
  pm-quotesize mul pm-quotesize min pm-qsizes exch pm-j exch put
  pm-qsizes pm-j get 3.4 vmin lt
    { [ (note ) pm-j (: the words are too long to quote on the card; mark fewer of them, at most about 30 characters) ] pm-cats pm-fail } if
} for
reading pm-nlines pm-lineh mul pm-tagh add pm-roomfor gt
  { [ (/reading is too long for the card; keep it under about 200 characters) ] pm-cats pm-fail } if
/pm-innerh reading pm-nlines pm-lineh mul pm-tagh add notes { pm-noteh max } forall def
/pm-mid pm-y0 poem length 1 sub pm-step mul 2 div sub pm-size 0.35 mul add def   % the poem's middle
/pm-cardh pm-innerh pm-pad 2 mul add def
/pm-cardy pm-mid pm-cardh 2 div sub pm-body 1 get max def
pm-cardy pm-cardh add pm-body 1 get pm-body 3 get add gt
  { /pm-cardy pm-body 1 get pm-body 3 get add pm-cardh sub def } if
/pm-card [ pm-side 0 get pm-cardy pm-side 2 get pm-cardh ] def
/pm-inner pm-card pm-pad inset def
/pm-top pm-inner 1 get pm-inner 3 get add def
/pm-tagbox   [ pm-inner 0 get pm-top pm-tagh sub pm-innerw pm-tagh ] def
/pm-quotebox [ pm-inner 0 get pm-top pm-tagh sub pm-quoteh sub pm-innerw pm-quoteh ] def
/pm-textbox  [ pm-inner 0 get pm-inner 1 get pm-innerw pm-quotebox 1 get pm-inner 1 get sub ] def
/pm-readbox  [ pm-inner 0 get pm-inner 1 get pm-innerw pm-tagbox 1 get pm-inner 1 get sub ] def

% ---- things at rest ----------------------------------------------------------
/pm-line { % i -> the poem's line i, set in its place
  /serif pm-size face dup pm-x exch pm-base moveto poem exch get show } def
/pm-wordbox { % note -> the box of its words in the poem
  /serif pm-size face dup 0 get pm-x exch pm-base moveto
  dup 0 get poem exch get exch 1 get partbox } def
/pm-mark { % note u -> the note's words recoloured, u from /fg to /accent
  exch dup pm-wordbox 0 get /pm-wx exch def
  /fg /accent 4 -1 roll mixink ink
  dup 0 get pm-base pm-wx exch moveto 1 get show } def
/pm-rule { % note u -> a rule drawn on under the note's words
  exch pm-wordbox 0 -0.9 vmin shifted exch /accent ink 0.45 vmin setlinewidth underline newpath } def
/pm-cardground { /surface ink pm-card 2 vmin roundpath fill
                 /line ink 0.15 vmin setlinewidth pm-card 2 vmin roundpath stroke } def
/pm-note { % j -> note j's text on the card
  dup pm-qsizes exch get /pm-qs exch def notes exch get
  dup 2 get pm-tagbox /title pm-tagsize face /accent ink /nw showin
  dup 1 get (") exch pm-cat (") pm-cat pm-quotebox /serif pm-qs face /fg ink /nw showin
  3 get pm-textbox /body pm-textsize face /fg ink << /Align /left /VAlign /top /Leading 1.4 >> paragraph } def
/pm-close { % the reading on the card
  (reading) pm-tagbox /title pm-tagsize face /accent ink /nw showin
  reading pm-readbox /body pm-textsize face /fg ink
  << /Align /left /VAlign /top /Leading 1.4 >> paragraph } def

% ---- the film ----------------------------------------------------------------
/scene {
  ground
  % the heading arrives and stays: modest, top left
  /open { [/rise pm-in] { heading pm-head /title heading-size face /fg ink /w showin } entering } frombeat
  % the poem, a line at a time, then its attribution
  /lines {
    {
      0 1 poem length 1 sub { /pm-i exch def
        poem pm-i get pm-linegap { [/rise pm-in] { pm-i pm-line } entering } then
      } for
      0 { [/fade pm-in] { poet pm-x poem length 1 sub pm-base pm-step 0.9 mul sub moveto
                          /body pm-poetsize face /muted ink show } entering } then
    } script
  } frombeat
  % the card arrives with the first note and stays
  /walk { /fade { pm-cardground } entering } frombeat
  % each note: its words light up and are underlined, the card says why
  /walk {
    {
      0 1 notes length 1 sub { /pm-j exch def notes pm-j get /pm-n exch def
        pm-n pm-notedur {
          pm-n 0.1 0.6 /cubic-out tween pm-rule                    % the rule stays
          0 pm-n pm-notedur { pm-n 0 0.4 ramp span 0.4 sub span ramp sub pm-mark
                              [/rise pm-in] [/fade 0.35] { pm-j pm-note } staged } during
        } then
      } for
    } script
  } frombeat
  % the reading, on the finished picture
  /close { [/rise pm-in] { pm-close } entering } frombeat
} def
